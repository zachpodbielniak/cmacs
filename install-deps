#!/usr/bin/env bash
# install-deps — Install all CMacs build dependencies
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Supported platforms:
#   Fedora / RHEL / CentOS Stream (dnf)
#   Ubuntu / Debian (apt)
#   Arch Linux (pacman)
#   macOS (Homebrew)
#   FreeBSD (pkg)
#
# Usage:
#   ./install-deps              # install everything (system + from-source)
#   ./install-deps --system     # system packages only
#   ./install-deps --from-source # build crispy, bacon, gowl from deps/
#   ./install-deps --ldconfig   # configure /usr/local/lib64 (Linux only)
#
# On Fedora Silverblue / immutable systems:
#   sudo bootc override -- ./install-deps --system
# or install inside a dev distrobox.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="${PREFIX:-/usr/local}"

# ── Platform detection ───────────────────────────────────────────────

detect_platform () {
	if [[ "$(uname)" == "Darwin" ]]; then
		echo "macos"
		return
	fi
	if [[ "$(uname)" == "FreeBSD" ]]; then
		echo "freebsd"
		return
	fi
	if [[ -f /etc/os-release ]]; then
		# shellcheck source=/dev/null
		. /etc/os-release
		case "${ID}" in
			fedora|rhel|centos|rocky|alma)
				echo "fedora"
				;;
			ubuntu|debian|linuxmint|pop)
				echo "debian"
				;;
			arch|manjaro|endeavouros)
				echo "arch"
				;;
			*)
				echo "unknown"
				;;
		esac
		return
	fi
	echo "unknown"
}

# ── Package lists per platform ───────────────────────────────────────
#
# Grouped by function:
#   PKGS_BUILD    — compilers, autotools, pkg-config, texinfo
#   PKGS_CORE     — gnutls, ncurses, zlib
#   PKGS_GUI      — gtk3 (pgtk backend)
#   PKGS_NCOMP    — libgccjit (native compilation)
#   PKGS_IMAGE    — xpm, jpeg, gif, tiff, rsvg, webp, imagemagick
#                   (rsvg is REQUIRED for the cmacs-ink canvas overlay)
#   PKGS_TEXT     — libotf, m17n-lib
#   PKGS_JSON     — jansson
#   PKGS_TS       — tree-sitter
#   PKGS_GLIB     — glib, gobject-introspection
#   PKGS_GOWL     — wlroots, wayland, libinput, xkbcommon, pango, cairo
#
# Android APK builds do NOT use this script — they run inside the
# `cmacs-android` container image (see Containerfile.android +
# `just android-image`).  The host needs only `podman` (or
# `docker`); JDK / Android SDK / NDK live in the image.

set_packages_fedora () {
	PKGS_BUILD=(autoconf automake gcc make pkgconf-pkg-config texinfo)
	PKGS_CORE=(gnutls-devel ncurses-devel zlib-devel)
	PKGS_GUI=(gtk3-devel)
	PKGS_NCOMP=(libgccjit-devel)
	PKGS_IMAGE=(libXpm-devel libjpeg-turbo-devel giflib-devel libtiff-devel
	            librsvg2-devel libwebp-devel ImageMagick-devel)
	PKGS_TEXT=(libotf-devel m17n-lib-devel)
	PKGS_JSON=(jansson-devel)
	PKGS_TS=(libtree-sitter-devel)
	# Cintrospect (runtime C self-introspection): libdw + libelf
	# parse /proc/self/exe DWARF; libdebuginfod fetches split-debug
	# DIEs from the distro debuginfo server; binutils-devel
	# (libopcodes) is used by cpatch for prologue probe.
	PKGS_INTROSPECT=(elfutils-devel elfutils-debuginfod-client-devel
	                 binutils-devel)
	PKGS_GLIB=(glib2-devel gobject-introspection-devel json-glib-devel
	           libsoup3-devel libdex-devel libetpan-devel libpq-devel
	           libssh2-devel libvirt-devel libyaml-devel
	           sqlite-devel cmark-devel)
	# Fedora 44+ ships wlroots-0.20 as wlroots-devel; gowl needs
	# wlroots-0.19, available as the wlroots0.19-devel compat package.
	local wlroots_pkg="wlroots-devel"
	if [[ -f /etc/os-release ]]; then
		# shellcheck source=/dev/null
		. /etc/os-release
		if [[ "${ID}" == "fedora" ]] \
		   && [[ "${VERSION_ID}" =~ ^[0-9]+$ ]] \
		   && (( VERSION_ID >= 44 )); then
			wlroots_pkg="wlroots0.19-devel"
		fi
	fi
	PKGS_GOWL=("${wlroots_pkg}" wayland-devel wayland-protocols-devel
	           libinput-devel libxkbcommon-devel pango-devel cairo-devel)
	# cmacs-video: GStreamer + plugins-{base,good,bad,ugly} + libav.
	# plugins-bad provides rtspsrc (RTSP + RTSPS); libav gives software
	# H.264/H.265 fallback when hardware decode is unavailable.
	#
	# IMPORTANT: Fedora's gstreamer1-libav is built against the
	# *-free ffmpeg variant (libavcodec-free etc.), which strips
	# patent-encumbered codecs --- including H.264 Main and High
	# profile, the encoding nearly all real-world IP cameras use.
	# Without the swap below you'll see RTSP streams reach state
	# `paused' but never produce frames, with the error
	# "Missing element: H.264 (Main Profile) decoder" from
	# decodebin.
	#
	# To make H.264 Main/High work you need the full ffmpeg from
	# RPM Fusion (Fedora doesn't ship it for licensing reasons):
	#
	#   sudo dnf install \
	#     https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm
	#   sudo dnf swap ffmpeg-free ffmpeg --allowerasing
	#   rm -rf ~/.cache/gstreamer-1.0
	#
	# Verify with: gst-inspect-1.0 avdec_h264   (must print Factory Details, not "No such element").
	#
	# This is required for security-camera use cases (Unifi, Reolink,
	# Amcrest, Hikvision, Axis, etc.) where Main or High profile is
	# the default.  Public test streams encoded with the Baseline
	# profile will play without this swap.
	PKGS_VIDEO=(gstreamer1-devel gstreamer1-plugins-base-devel
	            gstreamer1-plugins-good gstreamer1-plugins-bad-free-devel
	            gstreamer1-plugins-bad-free-extras gstreamer1-plugins-ugly-free
	            gstreamer1-libav)
	# cmacs-audio: pipewiresrc (preferred) + pulsesrc (fallback).
	# cmake + gcc-c++: bundled whisper.cpp build under deps/.
	# pipx + espeak-ng: piper-tts install + phonemization backend.
	PKGS_AUDIO=(pipewire-devel pipewire-libs pulseaudio-libs-devel
	            cmake gcc-c++ pipx espeak-ng)
	PKG_CMD="sudo dnf install -y"
}

set_packages_debian () {
	PKGS_BUILD=(autoconf automake gcc make pkg-config texinfo)
	PKGS_CORE=(libgnutls28-dev libncurses-dev zlib1g-dev)
	PKGS_GUI=(libgtk-3-dev)
	PKGS_NCOMP=(libgccjit-13-dev)
	PKGS_IMAGE=(libxpm-dev libjpeg-dev libgif-dev libtiff-dev
	            librsvg2-dev libwebp-dev libmagickwand-dev)
	PKGS_TEXT=(libotf-dev libm17n-dev)
	PKGS_JSON=(libjansson-dev)
	PKGS_TS=(libtree-sitter-dev)
	PKGS_INTROSPECT=(libdw-dev libelf-dev libdebuginfod-dev
	                 binutils-dev)
	PKGS_GLIB=(libglib2.0-dev libgirepository1.0-dev libjson-glib-dev
	           libsoup-3.0-dev libdex-dev libetpan-dev libpq-dev
	           libssh2-1-dev libvirt-dev libyaml-dev
	           libsqlite3-dev libcmark-dev)
	PKGS_GOWL=(libwlroots-dev libwayland-dev wayland-protocols
	           libinput-dev libxkbcommon-dev libpango1.0-dev libcairo2-dev)
	PKGS_VIDEO=(libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev
	            gstreamer1.0-plugins-good gstreamer1.0-plugins-bad
	            gstreamer1.0-plugins-ugly gstreamer1.0-libav)
	PKGS_AUDIO=(libpipewire-0.3-dev libpulse-dev cmake g++ pipx espeak-ng)
	PKG_CMD="sudo apt-get install -y"
	# NOTE: Ubuntu 24.04 (noble) ships wlroots 0.17, wayland 1.22,
	# wayland-protocols 1.34, and pixman 0.42 --- all too old for
	# gowl, which needs wlroots-0.19.  See doc_org/cmacs/build.org
	# section "Building on Ubuntu 24.04 / older hosts" for a
	# source-build recipe.  libdex-dev is also absent before 24.10;
	# build libdex from source on noble.
}

set_packages_arch () {
	PKGS_BUILD=(autoconf automake gcc make pkgconf texinfo)
	PKGS_CORE=(gnutls ncurses zlib)
	PKGS_GUI=(gtk3)
	PKGS_NCOMP=(libgccjit)
	PKGS_IMAGE=(libxpm libjpeg-turbo giflib libtiff librsvg libwebp imagemagick)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	PKGS_INTROSPECT=(elfutils debuginfod)
	PKGS_GLIB=(glib2 gobject-introspection json-glib libsoup3 libdex
	           libetpan postgresql-libs libssh2 libvirt libyaml
	           sqlite cmark)
	PKGS_GOWL=(wlroots wayland wayland-protocols libinput libxkbcommon pango cairo)
	PKGS_VIDEO=(gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad
	            gst-plugins-ugly gst-libav)
	PKGS_AUDIO=(pipewire libpulse cmake python-pipx espeak-ng)
	PKG_CMD="sudo pacman -S --needed --noconfirm"
}

set_packages_macos () {
	PKGS_BUILD=(autoconf automake gcc make pkg-config texinfo)
	PKGS_CORE=(gnutls)
	PKGS_GUI=(gtk+3)
	PKGS_NCOMP=(libgccjit)
	PKGS_IMAGE=(libxpm jpeg-turbo giflib libtiff librsvg webp imagemagick)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	# Homebrew elfutils provides libdw + libelf; libdebuginfod is
	# absent on macOS but cintrospect degrades gracefully.
	PKGS_INTROSPECT=(elfutils)
	PKGS_GLIB=(glib gobject-introspection json-glib libsoup libdex
	           libetpan libpq libssh2 libvirt libyaml
	           sqlite cmark)
	PKGS_GOWL=()  # Wayland not available on macOS
	PKGS_VIDEO=(gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad
	            gst-plugins-ugly gst-libav)
	# pipewire is best-effort on macOS; cmacs-audio falls back to
	# coreaudiosrc (provided by gst-plugins-good) when pipewiresrc is
	# unavailable.  Set cmacs-audio-capture-source to 'coreaudio on macOS.
	PKGS_AUDIO=(pipewire cmake pipx espeak-ng)
	PKG_CMD="brew install"
}

set_packages_freebsd () {
	PKGS_BUILD=(autoconf automake gcc gmake pkgconf texinfo)
	PKGS_CORE=(gnutls ncurses)
	PKGS_GUI=(gtk3)
	PKGS_NCOMP=()  # libgccjit not readily available; native-comp optional
	PKGS_IMAGE=(libXpm jpeg-turbo giflib tiff librsvg2 webp ImageMagick7-nox11)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	PKGS_INTROSPECT=(elfutils)
	PKGS_GLIB=(glib gobject-introspection json-glib libsoup3 libdex
	           libetpan postgresql16-client libssh2 libvirt libyaml
	           sqlite3 cmark)
	PKGS_GOWL=()  # Wayland compositor support limited on FreeBSD
	PKGS_VIDEO=(gstreamer1 gstreamer1-plugins-core gstreamer1-plugins-good
	            gstreamer1-plugins-bad gstreamer1-plugins-ugly
	            gstreamer1-plugins-libav)
	PKGS_AUDIO=(pipewire pulseaudio cmake py39-pipx espeak-ng)
	PKG_CMD="sudo pkg install -y"
}

# ── Collect all packages ─────────────────────────────────────────────

all_packages () {
	echo "${PKGS_BUILD[@]}" \
	     "${PKGS_CORE[@]}" \
	     "${PKGS_GUI[@]}" \
	     "${PKGS_NCOMP[@]}" \
	     "${PKGS_IMAGE[@]}" \
	     "${PKGS_TEXT[@]}" \
	     "${PKGS_JSON[@]}" \
	     "${PKGS_TS[@]}" \
	     "${PKGS_INTROSPECT[@]}" \
	     "${PKGS_GLIB[@]}" \
	     "${PKGS_GOWL[@]}" \
	     "${PKGS_VIDEO[@]}" \
	     "${PKGS_AUDIO[@]}"
}

# ── Install system packages ──────────────────────────────────────────

install_system_deps () {
	local platform
	platform="$(detect_platform)"

	case "${platform}" in
		fedora)  set_packages_fedora ;;
		debian)  set_packages_debian ;;
		arch)    set_packages_arch ;;
		macos)   set_packages_macos ;;
		freebsd) set_packages_freebsd ;;
		*)
			echo "ERROR: Unsupported platform." >&2
			echo "Supported: Fedora/RHEL, Ubuntu/Debian, Arch, macOS, FreeBSD" >&2
			exit 1
			;;
	esac

	local pkgs
	pkgs="$(all_packages)"

	echo "==> Platform: ${platform}"
	echo "==> Installing system packages..."

	if [[ "${platform}" == "macos" ]]; then
		if ! command -v brew &>/dev/null; then
			echo "ERROR: Homebrew not found. Install from https://brew.sh" >&2
			exit 1
		fi
	fi

	# shellcheck disable=SC2086
	${PKG_CMD} ${pkgs}

	if [[ ${#PKGS_GOWL[@]} -eq 0 ]]; then
		echo ""
		echo "NOTE: Gowl (Wayland compositor) deps skipped — not available on ${platform}."
		echo "      Configure with --without-cmacs-gowl on this platform."
	fi

	if [[ ${#PKGS_NCOMP[@]} -eq 0 ]]; then
		echo ""
		echo "NOTE: libgccjit not available on ${platform}."
		echo "      Configure without --with-native-compilation on this platform."
	fi
}

# ── From-source CMacs dependencies ──────────────────────────────────
# Built from deps/ and installed to PREFIX so their .so, headers,
# pkg-config files, and GI typelibs are discoverable at runtime.
# pkg-config names: mcp-glib-1.0, crispy, bacon-1.0, gowl,
#                   podomation-1.0, libreclaw

build_from_source () {
	local platform
	platform="$(detect_platform)"
	local make_cmd="make"

	if [[ "${platform}" == "freebsd" ]]; then
		make_cmd="gmake"
	fi

	echo "==> Building from-source dependencies (PREFIX=${PREFIX})..."

	for dep in mcp-glib crispy bacon gowl podomation libreclaw; do
		dep_dir="${SCRIPT_DIR}/deps/${dep}"
		if [[ ! -d "${dep_dir}" ]]; then
			echo "    SKIP ${dep} (${dep_dir} not found)"
			continue
		fi
		if [[ "${dep}" == "gowl" && "${platform}" == "macos" ]]; then
			echo "    SKIP gowl (Wayland not available on macOS)"
			continue
		fi
		if [[ "${dep}" == "gowl" && "${platform}" == "freebsd" ]]; then
			echo "    SKIP gowl (Wayland compositor limited on FreeBSD)"
			continue
		fi
		echo "    Building ${dep}..."
		${make_cmd} -C "${dep_dir}" clean all PREFIX="${PREFIX}"
		sudo ${make_cmd} -C "${dep_dir}" install PREFIX="${PREFIX}"
	done

	# whisper.cpp: ships its own Makefile.  Build the static lib only;
	# cmacs links it in-tree from configure.ac.  No `make install` needed.
	if [[ -d "${SCRIPT_DIR}/deps/whisper.cpp" ]]; then
		echo "    Building whisper.cpp (static library)..."
		${make_cmd} -C "${SCRIPT_DIR}/deps/whisper.cpp" libwhisper.a
	fi

	# piper: OHF-Voice piper1-GPL is a Python package; the `piper`
	# console-script is installed by pip.  Skipped if the user already
	# has piper.
	#
	# We prefer `pip install --user` over `pipx` because piper-tts's
	# scikit-build-core wheel races pipx's metadata-readback step when
	# pipx uses uv as its backend (auto-detected on systems where uv
	# is on PATH).  This shows up as
	#   "Pipx Internal Error: cannot find package 'piper-tts' metadata."
	# even though the actual wheel install succeeded.  `pip --user`
	# sidesteps the whole pipx/uv layer.
	#
	# Use /usr/bin/python3 explicitly when present so we hit the
	# distro-managed interpreter rather than a brew/conda Python that
	# may have been rebuilt out from under a cached venv path.
	if ! command -v piper >/dev/null 2>&1; then
		echo "    Installing piper-tts (Python package)..."
		_pyexe=""
		for cand in /usr/bin/python3 python3 python; do
			if command -v "$cand" >/dev/null 2>&1; then
				_pyexe="$cand"; break
			fi
		done
		if [[ -n "$_pyexe" ]] && "$_pyexe" -m pip --version >/dev/null 2>&1; then
			"$_pyexe" -m pip install --user piper-tts
		elif command -v pipx >/dev/null 2>&1; then
			# Last resort.  May fail on the uv-backend metadata race;
			# see comment above.
			pipx install --python "${_pyexe:-python3}" piper-tts
		else
			echo "    WARNING: no pip/pipx found; install piper-tts manually:"
			echo "             python3 -m pip install --user piper-tts"
		fi
	fi

	configure_ldconfig
}

# ── ldconfig / library path ──────────────────────────────────────────
# Libraries installed to PREFIX need to be discoverable at runtime.
# Linux: ldconfig    macOS: handled by brew/install_name    FreeBSD: ldconfig

configure_ldconfig () {
	local platform
	platform="$(detect_platform)"

	case "${platform}" in
		macos)
			echo "==> macOS: no ldconfig needed (dyld handles ${PREFIX}/lib)"
			return
			;;
		freebsd)
			local lib_dir="${PREFIX}/lib"
			echo "==> Configuring ldconfig for ${lib_dir}..."
			if ! ldconfig -r 2>/dev/null | grep -q "${lib_dir}"; then
				sudo sh -c "echo '${lib_dir}' >> /etc/ld-elf.conf"
			fi
			sudo ldconfig
			return
			;;
	esac

	# Linux
	local conf="/etc/ld.so.conf.d/local.conf"
	local lib_dir="${PREFIX}/lib64"

	if [[ ! -d "${lib_dir}" ]]; then
		lib_dir="${PREFIX}/lib"
	fi

	echo "==> Configuring ldconfig for ${lib_dir}..."
	if ! grep -qxF "${lib_dir}" "${conf}" 2>/dev/null; then
		echo "${lib_dir}" | sudo tee -a "${conf}" > /dev/null
	fi
	sudo ldconfig
}

# ── Main ─────────────────────────────────────────────────────────────

usage () {
	echo "Usage: $0 [--system|--from-source|--ldconfig|--list]"
	echo ""
	echo "  (no args)      Install everything (system + from-source)"
	echo "  --system       System packages only"
	echo "  --from-source  Build mcp-glib, crispy, bacon, gowl,"
	echo "                 podomation, libreclaw from deps/"
	echo "  --ldconfig     Configure library path (Linux/FreeBSD)"
	echo "  --list         Print package list for detected platform (dry run)"
	echo ""
	echo "Supported platforms:"
	echo "  Fedora / RHEL / CentOS Stream    (dnf)"
	echo "  Ubuntu / Debian / Mint / Pop!_OS (apt)"
	echo "  Arch / Manjaro / EndeavourOS     (pacman)"
	echo "  macOS                            (Homebrew)"
	echo "  FreeBSD                          (pkg)"
	echo ""
	echo "Configure CMacs with:"
	echo "  ./configure --with-pgtk --with-native-compilation \\"
	echo "    --with-json --with-tree-sitter \\"
	echo "    --with-cmacs-glib --with-cmacs-gi \\"
	echo "    --with-cmacs-crispy --with-cmacs-bacon --with-cmacs-gowl \\"
	echo "    --with-cmacs-podomation --with-cmacs-libreclaw \\"
	echo "    --with-cmacs-org-ex --with-cmacs-mcp"
}

list_packages () {
	local platform
	platform="$(detect_platform)"

	case "${platform}" in
		fedora)  set_packages_fedora ;;
		debian)  set_packages_debian ;;
		arch)    set_packages_arch ;;
		macos)   set_packages_macos ;;
		freebsd) set_packages_freebsd ;;
		*)
			echo "ERROR: Unsupported platform." >&2
			exit 1
			;;
	esac

	echo "Platform: ${platform}"
	echo "Install command: ${PKG_CMD}"
	echo ""
	echo "Build tools:     ${PKGS_BUILD[*]}"
	echo "Core libs:       ${PKGS_CORE[*]}"
	echo "GUI (pgtk):      ${PKGS_GUI[*]}"
	echo "Native comp:     ${PKGS_NCOMP[*]:-N/A}"
	echo "Image libs:      ${PKGS_IMAGE[*]}"
	echo "Text rendering:  ${PKGS_TEXT[*]}"
	echo "JSON:            ${PKGS_JSON[*]}"
	echo "Tree-sitter:     ${PKGS_TS[*]}"
	echo "GLib/GI:         ${PKGS_GLIB[*]}"
	echo "Gowl (Wayland):  ${PKGS_GOWL[*]:-N/A}"
	echo ""
	echo "From source (deps/): mcp-glib, crispy, bacon, gowl, podomation, libreclaw"
}

main () {
	local mode="${1:-all}"

	case "${mode}" in
		--system)
			install_system_deps
			;;
		--from-source)
			build_from_source
			;;
		--ldconfig)
			configure_ldconfig
			;;
		--list)
			list_packages
			;;
		--help|-h)
			usage
			;;
		all)
			install_system_deps
			build_from_source
			;;
		*)
			echo "Unknown option: ${mode}" >&2
			usage
			exit 1
			;;
	esac

	echo "==> Done."
}

main "$@"
