#!/usr/bin/env bash
# install-deps — Install all CMacs build dependencies
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Supported platforms:
#   Fedora / RHEL / CentOS Stream (dnf)
#   Ubuntu / Debian (apt)
#   Arch Linux (pacman)
#   macOS (Homebrew)
#   FreeBSD (pkg)
#
# Usage:
#   ./install-deps              # install everything (system + from-source)
#   ./install-deps --system     # system packages only
#   ./install-deps --from-source # build crispy, bacon, gowl from deps/
#   ./install-deps --ldconfig   # configure /usr/local/lib64 (Linux only)
#
# On Fedora Silverblue / immutable systems:
#   sudo bootc override -- ./install-deps --system
# or install inside a dev distrobox.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="${PREFIX:-/usr/local}"

# ── Platform detection ───────────────────────────────────────────────

detect_platform () {
	if [[ "$(uname)" == "Darwin" ]]; then
		echo "macos"
		return
	fi
	if [[ "$(uname)" == "FreeBSD" ]]; then
		echo "freebsd"
		return
	fi
	if [[ -f /etc/os-release ]]; then
		# shellcheck source=/dev/null
		. /etc/os-release
		case "${ID}" in
			fedora|rhel|centos|rocky|alma)
				echo "fedora"
				;;
			ubuntu|debian|linuxmint|pop)
				echo "debian"
				;;
			arch|manjaro|endeavouros)
				echo "arch"
				;;
			*)
				echo "unknown"
				;;
		esac
		return
	fi
	echo "unknown"
}

# ── Package lists per platform ───────────────────────────────────────
#
# Grouped by function:
#   PKGS_BUILD    — compilers, autotools, pkg-config, texinfo
#   PKGS_CORE     — gnutls, ncurses, zlib
#   PKGS_GUI      — gtk3 (pgtk backend)
#   PKGS_NCOMP    — libgccjit (native compilation)
#   PKGS_IMAGE    — xpm, jpeg, gif, tiff, rsvg, webp, imagemagick
#                   (rsvg is REQUIRED for the cmacs-ink canvas overlay)
#   PKGS_TEXT     — libotf, m17n-lib
#   PKGS_JSON     — jansson
#   PKGS_TS       — tree-sitter
#   PKGS_GLIB     — glib, gobject-introspection
#   PKGS_GOWL     — wlroots, wayland, libinput, xkbcommon, pango, cairo
#   PKGS_LIBREGNUM — mesa GL + X11 devel libs (raylib's window/input
#                    backend is X11 even when we use the hidden-window
#                    + offscreen-FBO mode under Wayland).
#
# Android APK builds do NOT use this script — they run inside the
# `cmacs-android` container image (see Containerfile.android +
# `just android-image`).  The host needs only `podman` (or
# `docker`); JDK / Android SDK / NDK live in the image.

set_packages_fedora () {
	PKGS_BUILD=(autoconf automake gcc make pkgconf-pkg-config texinfo)
	PKGS_CORE=(gnutls-devel ncurses-devel zlib-devel)
	# webkit2gtk4.1-devel: --with-xwidgets (xwidget-webkit browser
	# buffers) AND --with-cmacs-gsurf (the embedded gsurf web browser,
	# which links libgsurf.a against the same GTK3/WebKit2GTK 4.1 stack
	# + yaml/json-glib from PKGS_GLIB).  Must be the 4.1 (GTK3 /
	# libsoup3) ABI -- the 6.0 package is GTK4-only and unusable from
	# Emacs pgtk (GTK3).
	PKGS_GUI=(gtk3-devel webkit2gtk4.1-devel)
	PKGS_NCOMP=(libgccjit-devel)
	PKGS_IMAGE=(libXpm-devel libjpeg-turbo-devel giflib-devel libtiff-devel
	            librsvg2-devel libwebp-devel ImageMagick-devel)
	PKGS_TEXT=(libotf-devel m17n-lib-devel)
	PKGS_JSON=(jansson-devel)
	PKGS_TS=(libtree-sitter-devel)
	# Cintrospect (runtime C self-introspection): libdw + libelf
	# parse /proc/self/exe DWARF; libdebuginfod fetches split-debug
	# DIEs from the distro debuginfo server; binutils-devel
	# (libopcodes) is used by cpatch for prologue probe.
	PKGS_INTROSPECT=(elfutils-devel elfutils-debuginfod-client-devel
	                 binutils-devel)
	PKGS_GLIB=(glib2-devel gobject-introspection-devel json-glib-devel
	           libsoup3-devel libdex-devel libetpan-devel libpq-devel
	           libssh2-devel libvirt-devel libyaml-devel
	           sqlite-devel cmark-devel)
	# wlroots: gowl builds against 0.19 OR 0.20 (newest present wins;
	# see deps/gowl/config.mk).  Prefer 0.20 -- it unlocks per-window
	# screencast capture (the "share a specific window" portal option);
	# 0.19 is monitor-only.  Fedora 44+ ships 0.20 as wlroots-devel.
	# Fedora 42/43 ship 0.19 only, as wlroots-devel there (the bare
	# package IS 0.19 on those releases), so wlroots-devel is correct
	# everywhere -- it resolves to whatever that release's latest
	# wlroots is.  (The wlroots0.19-devel compat package is only needed
	# to FORCE 0.19 on a 44+ host, which we no longer do by default.)
	local wlroots_pkg="wlroots-devel"
	# libxcb-devel + xcb-util-wm-devel provide the xcb/xcb-icccm
	# pkg-configs gowl's XWayland support needs at build time (else it
	# silently compiles out); xorg-x11-server-Xwayland is the rootless
	# X server gowl launches so X11 apps (e.g. raylib/GLFW) get a DISPLAY.
	PKGS_GOWL=("${wlroots_pkg}" wayland-devel wayland-protocols-devel
	           libinput-devel libxkbcommon-devel pango-devel cairo-devel
	           libxcb-devel xcb-util-wm-devel xorg-x11-server-Xwayland
	           libeis-devel            # EIS server for the InputCapture/RemoteDesktop portal (deskflow KVM)
	           xdg-desktop-portal-wlr  # wlroots ScreenCast/Screenshot portal backend (runtime)
	           slurp)                  # output/region chooser for the portal-wlr ScreenCast picker
	# cmacs-video: GStreamer + plugins-{base,good,bad,ugly} + libav.
	# plugins-bad provides rtspsrc (RTSP + RTSPS); libav gives software
	# H.264/H.265 fallback when hardware decode is unavailable.
	#
	# IMPORTANT: Fedora's gstreamer1-libav is built against the
	# *-free ffmpeg variant (libavcodec-free etc.), which strips
	# patent-encumbered codecs --- including H.264 Main and High
	# profile, the encoding nearly all real-world IP cameras use.
	# Without the swap below you'll see RTSP streams reach state
	# `paused' but never produce frames, with the error
	# "Missing element: H.264 (Main Profile) decoder" from
	# decodebin.
	#
	# To make H.264 Main/High work you need the full ffmpeg from
	# RPM Fusion (Fedora doesn't ship it for licensing reasons):
	#
	#   sudo dnf install \
	#     https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm
	#   sudo dnf swap ffmpeg-free ffmpeg --allowerasing
	#   rm -rf ~/.cache/gstreamer-1.0
	#
	# Verify with: gst-inspect-1.0 avdec_h264   (must print Factory Details, not "No such element").
	#
	# This is required for security-camera use cases (Unifi, Reolink,
	# Amcrest, Hikvision, Axis, etc.) where Main or High profile is
	# the default.  Public test streams encoded with the Baseline
	# profile will play without this swap.
	PKGS_VIDEO=(gstreamer1-devel gstreamer1-plugins-base-devel
	            gstreamer1-plugins-good gstreamer1-plugins-bad-free-devel
	            gstreamer1-plugins-bad-free-extras gstreamer1-plugins-ugly-free
	            gstreamer1-libav)
	# cmacs-audio: pipewiresrc (preferred) + pulsesrc (fallback).
	# cmake + gcc-c++: bundled whisper.cpp build under deps/.
	# pipx + espeak-ng: piper-tts install + phonemization backend.
	PKGS_AUDIO=(pipewire-devel pipewire-libs pulseaudio-libs-devel
	            cmake gcc-c++ pipx espeak-ng)
	# cmacs-libregnum: raylib (via graylib/libregnum) needs GL +
	# Xlib + the four input-related X11 libs even when we run it
	# in FLAG_WINDOW_HIDDEN mode -- raylib's InitWindow still
	# initialises X11 to construct the offscreen GL context.
	PKGS_LIBREGNUM=(mesa-libGL-devel libX11-devel libXrandr-devel
	                libXcursor-devel libXinerama-devel libXi-devel)
	# libregnum scripting backends for the in-Emacs level editor: luajit-devel
	# (Lua), python3-devel (Python), gjs-devel (JavaScript; pulls mozjsNN-devel).
	# Optional -- without them only the crispy (compile-and-run C) backend is
	# available.  gjs additionally uses gobject-introspection-devel (in
	# PKGS_GLIB).  crispy comes from the deps/ submodule, no system package.
	# python3-gobject (PyGObject) is the runtime that lets Python scripts do
	# `from gi.repository import Libregnum` against the auto-built typelib (gjs
	# has its own GI loader built in).
	PKGS_LIBREGNUM+=(luajit-devel python3-devel gjs-devel python3-gobject)
	# cmacs-cad (cad-glib): OpenCASCADE is the system B-rep kernel
	# (never vendored; deps/cad-glib probes /usr/include/opencascade).
	# eigen3 is for the gated libfive f-rep kernel (CAD_FIVE=1); the
	# vendored solvespace solver uses its own in-tree Eigen.  cmake +
	# gcc-c++ (PKGS_AUDIO) build the vendored manifold/slvs kernels.
	PKGS_CAD=(opencascade-devel eigen3-devel)
	PKG_CMD="sudo dnf install -y"
}

set_packages_debian () {
	PKGS_BUILD=(autoconf automake gcc make pkg-config texinfo)
	PKGS_CORE=(libgnutls28-dev libncurses-dev zlib1g-dev)
	PKGS_GUI=(libgtk-3-dev libwebkit2gtk-4.1-dev)
	PKGS_NCOMP=(libgccjit-13-dev)
	PKGS_IMAGE=(libxpm-dev libjpeg-dev libgif-dev libtiff-dev
	            librsvg2-dev libwebp-dev libmagickwand-dev)
	PKGS_TEXT=(libotf-dev libm17n-dev)
	PKGS_JSON=(libjansson-dev)
	PKGS_TS=(libtree-sitter-dev)
	PKGS_INTROSPECT=(libdw-dev libelf-dev libdebuginfod-dev
	                 binutils-dev)
	# libgirepository-2.0-dev: GLib's integrated GIRepository 2.0
	# (girepository-2.0.pc, <girepository/girepository.h>), used by the
	# bacon gobject_inspector module and libregnum's GI scripting backend.
	# Distinct from libgirepository1.0-dev (the legacy 1.0 API).  On Fedora
	# this header ships inside glib2-devel, so it only needs naming here.
	# In Ubuntu it lives in the 'universe' component.
	PKGS_GLIB=(libglib2.0-dev libgirepository1.0-dev libgirepository-2.0-dev
	           libjson-glib-dev libsoup-3.0-dev libdex-dev libetpan-dev
	           libpq-dev libssh2-1-dev libvirt-dev libyaml-dev
	           libsqlite3-dev libcmark-dev)
	# libxcb1-dev + libxcb-icccm4-dev: XWayland build deps (xcb/xcb-icccm);
	# xwayland: the rootless X server gowl spawns for X11 clients.
	PKGS_GOWL=(libwlroots-dev libwayland-dev wayland-protocols
	           libinput-dev libxkbcommon-dev libpango1.0-dev libcairo2-dev
	           libxcb1-dev libxcb-icccm4-dev xwayland
	           xdg-desktop-portal-wlr  # wlroots ScreenCast/Screenshot portal backend (runtime)
	           slurp)                  # output/region chooser for the portal-wlr ScreenCast picker
	PKGS_VIDEO=(libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev
	            gstreamer1.0-plugins-good gstreamer1.0-plugins-bad
	            gstreamer1.0-plugins-ugly gstreamer1.0-libav)
	PKGS_AUDIO=(libpipewire-0.3-dev libpulse-dev cmake g++
	            python3-venv pipx espeak-ng)
	PKGS_LIBREGNUM=(libgl1-mesa-dev libx11-dev libxrandr-dev
	                libxcursor-dev libxinerama-dev libxi-dev)
	# cmacs-cad: OCCT splits into per-module -dev packages on Debian.
	PKGS_CAD=(libocct-foundation-dev libocct-modeling-data-dev
	          libocct-modeling-algorithms-dev libocct-data-exchange-dev
	          libeigen3-dev)
	PKG_CMD="sudo apt-get install -y"
	# NOTE: Ubuntu 24.04 (noble) ships wlroots 0.17, wayland 1.22,
	# wayland-protocols 1.34, and pixman 0.42 --- all too old for
	# gowl, which needs wlroots 0.19 or 0.20 (0.20 for per-window
	# screencast capture).  Build wlroots (and the rest of the stack)
	# from source -- see doc_org/cmacs/build.org "Building on Ubuntu
	# 24.04 / older hosts" and deps/gowl/docs/building.org "wlroots
	# version".  libdex-dev is also absent before 24.10; build libdex
	# from source on noble.
}

