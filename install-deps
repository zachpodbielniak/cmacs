# ── Collect all packages ─────────────────────────────────────────────

all_packages () {
	echo "${PKGS_BUILD[@]}" \
	     "${PKGS_CORE[@]}" \
	     "${PKGS_GUI[@]}" \
	     "${PKGS_NCOMP[@]}" \
	     "${PKGS_IMAGE[@]}" \
	     "${PKGS_TEXT[@]}" \
	     "${PKGS_JSON[@]}" \
	     "${PKGS_TS[@]}" \
	     "${PKGS_INTROSPECT[@]}" \
	     "${PKGS_GLIB[@]}" \
	     "${PKGS_GOWL[@]}" \
	     "${PKGS_VIDEO[@]}" \
	     "${PKGS_AUDIO[@]}" \
	     "${PKGS_LIBREGNUM[@]}" \
	     "${PKGS_CAD[@]}" \
	     "${PKGS_OFFICE[@]}" \
	     "${PKGS_DBEXPLORER[@]}"
}

# ── Install system packages ──────────────────────────────────────────

# Install the packages this host actually carries, and say plainly which
# ones it does not.  See the pkg_available comment for why filtering is
# not optional: one unknown name otherwise aborts the whole transaction
# and installs nothing.
install_packages () {
	local platform="$1"; shift

	partition_packages "${platform}" "$@"

	if [[ ${#AVAIL[@]} -gt 0 ]]; then
		# shellcheck disable=SC2086
		${PKG_CMD} "${AVAIL[@]}"
	fi

	if [[ ${#MISSING[@]} -eq 0 ]]; then
		return 0
	fi

	echo ""
	echo "WARNING: these packages are not in your configured repositories"
	echo "         and were skipped:"
	echo "         ${MISSING[*]}"
	case "${platform}" in
		debian)
			echo "         If one lives in 'universe', enable it and re-run:"
			echo "             sudo add-apt-repository universe && sudo apt-get update"
			;;
		arch)
			echo "         Some cmacs deps live in the AUR; install those with"
			echo "         an AUR helper, e.g.:  yay -S ${MISSING[*]}"
			;;
		fedora)
			echo "         Some may need RPM Fusion:"
			echo "             sudo dnf install \\"
			echo "               https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-\$(rpm -E %fedora).noarch.rpm"
			;;
	esac
	echo "         Otherwise build from source --- see doc_org/cmacs/build.org."
	echo "         Run './install-deps --check' to see which build"
	echo "         dependencies are still unsatisfied."
}

install_system_deps () {
	local platform
	platform="$(detect_platform)"

	echo "==> Platform: ${platform}"

	if [[ "${platform}" == "macos" ]]; then
		if ! command -v brew &>/dev/null; then
			echo "ERROR: Homebrew not found. Install from https://brew.sh" >&2
			exit 1
		fi
	fi

	# Refresh the package index BEFORE building the lists, not just
	# before installing: set_packages_* probes that index to choose
	# between versioned package names (wlroots, libgccjit).  On a fresh
	# container /var/lib/apt/lists is empty, so probing first would find
	# nothing and silently pick the wrong fallback for every one of them.
	if [[ "${platform}" == "debian" ]]; then
		echo "==> Refreshing package index..."
		sudo apt-get update || true
	fi

	# Same problem on a bare Arch container, where /var/lib/pacman/sync
	# is empty until the first -Sy.  Refresh ONLY in that case: on a
	# normal Arch install the databases are already there, and a bare
	# `pacman -Sy' before installing is the classic partial-upgrade
	# footgun, so we must not do it routinely.
	if [[ "${platform}" == "arch" ]]; then
		if ! compgen -G "/var/lib/pacman/sync/*.db" >/dev/null 2>&1; then
			echo "==> Empty pacman sync database; refreshing..."
			sudo pacman -Sy --noconfirm || true
		fi
	fi

	case "${platform}" in
		fedora)  set_packages_fedora ;;
		debian)  set_packages_debian ;;
		arch)    set_packages_arch ;;
		macos)   set_packages_macos ;;
		freebsd) set_packages_freebsd ;;
		*)
			echo "ERROR: Unsupported platform." >&2
			echo "Supported: Fedora/RHEL, Ubuntu/Debian, Arch, macOS, FreeBSD" >&2
			echo "(Derivatives are matched via ID_LIKE in /etc/os-release.)" >&2
			exit 1
			;;
	esac

	local pkgs
	pkgs="$(all_packages)"

	echo "==> Installing system packages..."

	# shellcheck disable=SC2086
	install_packages "${platform}" ${pkgs}

	if [[ ${#PKGS_GOWL[@]} -eq 0 ]]; then
		echo ""
		echo "NOTE: Gowl (Wayland compositor) deps skipped — not available on ${platform}."
		echo "      Configure with --without-cmacs-gowl on this platform."
	fi

	if [[ ${#PKGS_NCOMP[@]} -eq 0 ]]; then
		echo ""
		echo "NOTE: libgccjit not available on ${platform}."
		echo "      Configure without --with-native-compilation on this platform."
	fi

	# Report every still-unsatisfied dependency now, as one list, rather
	# than letting the build surface them one per 20-minute run.  Only
	# advisory here: a missing optional dep must not fail the install.
	if [[ "${platform}" != "macos" && "${platform}" != "freebsd" ]]; then
		echo ""
		check_build_deps || true
	fi
}

# ── Verify the build's actual dependencies ───────────────────────────
#
# Package names drift between releases; what the build genuinely cares
# about is the pkg-config modules.  Checking those directly turns "the
# build dies on a different missing dep every 20 minutes" into one list,
# up front.  Keep in sync with configure.ac's PKG_CHECK_MODULES and the
# DEPS_REQUIRED / PKG_DEPS lines in deps/*/config.mk.

# Modules whose absence fails the default (`just bootstrap') flag set.
#
# jansson is deliberately NOT here even though the package lists above
# still install it: Emacs 30 replaced it with a built-in JSON parser,
# and nothing in configure.ac, src/, or any dep references it any more.
# Listing it made --check report a missing *required* dependency, and
# exit 1, on a tree that builds perfectly well.
CHECK_REQUIRED=(
	glib-2.0 gobject-2.0 gio-2.0 gio-unix-2.0 gmodule-2.0
	gobject-introspection-1.0
	json-glib-1.0 yaml-0.1 readline libsoup-3.0 libdex-1 libcmark
	sqlite3 libetpan libpq libssh2 libxml-2.0 libpng libzip gudev-1.0
	gnutls harfbuzz freetype2 fontconfig tree-sitter
	gtk+-3.0 webkit2gtk-4.1 javascriptcoregtk-4.1
	wayland-server wayland-client wayland-protocols xkbcommon libinput
	cairo pango pixman-1 egl gl
)

# Absent -> a feature narrows or compiles out; the build still succeeds.
# xcb/xcb-icccm gate gowl's XWayland support, which otherwise compiles
# out *silently* -- X11 clients then get no DISPLAY under gowl.  Listing
# them here is what makes that visible.  girepository-2.0, luajit,
# python3-embed and gjs-1.0 are libregnum's optional scripting backends
# (configure.ac probes them in a loop); elisp scripting needs none of them.
CHECK_OPTIONAL=(
	xcb xcb-icccm girepository-2.0
	libdecor-0 libeis-1.0 libvirt libdw libelf libdebuginfod
	gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0
	libpipewire-0.3 libpulse eigen3 luajit python3-embed gjs-1.0
)

check_build_deps () {
	local m missing_req=() missing_opt=() missing_bin=() b
	local rc=0

	echo "==> Checking build dependencies (pkg-config modules + tools)..."

	if ! command -v pkg-config >/dev/null 2>&1 && \
	   ! command -v pkgconf >/dev/null 2>&1; then
		echo "ERROR: pkg-config/pkgconf not installed --- run './install-deps --system' first." >&2
		return 1
	fi

	for b in autoconf automake make gcc git makeinfo cmake; do
		command -v "${b}" >/dev/null 2>&1 || missing_bin+=("${b}")
	done

	for m in "${CHECK_REQUIRED[@]}"; do
		pkg-config --exists "${m}" 2>/dev/null || missing_req+=("${m}")
	done

	# gowl accepts either wlroots ABI, so neither alone is required.
	if ! pkg-config --exists wlroots-0.20 2>/dev/null && \
	   ! pkg-config --exists wlroots-0.19 2>/dev/null; then
		missing_req+=("wlroots-0.20 (or wlroots-0.19)")
	fi

	for m in "${CHECK_OPTIONAL[@]}"; do
		pkg-config --exists "${m}" 2>/dev/null || missing_opt+=("${m}")
	done

	if [[ ${#missing_bin[@]} -gt 0 ]]; then
		echo ""
		echo "MISSING build tools:"
		printf '    %s\n' "${missing_bin[@]}"
		rc=1
	fi

	if [[ ${#missing_req[@]} -gt 0 ]]; then
		echo ""
		echo "MISSING required dependencies (${#missing_req[@]}):"
		printf '    %s\n' "${missing_req[@]}"
		rc=1
	fi

	if [[ ${#missing_opt[@]} -gt 0 ]]; then
		echo ""
		echo "Missing OPTIONAL dependencies (${#missing_opt[@]}) --- the build will"
		echo "succeed; these features narrow or compile out:"
		printf '    %s\n' "${missing_opt[@]}"
	fi

	if [[ ${rc} -eq 0 ]]; then
		echo "==> All required build dependencies satisfied."
	else
		echo ""
		echo "Run './install-deps --system' to install them." >&2
	fi
	return ${rc}
}

# ── From-source CMacs dependencies ──────────────────────────────────
# Built from deps/ and installed to PREFIX so their .so, headers,
# pkg-config files, and GI typelibs are discoverable at runtime.
# pkg-config names: mcp-glib-1.0, crispy, bacon-1.0, gowl,
#                   podomation-1.0, libreclaw

build_from_source () {
	local platform
	platform="$(detect_platform)"
	local make_cmd="make"

	if [[ "${platform}" == "freebsd" ]]; then
		make_cmd="gmake"
	fi

	echo "==> Building from-source dependencies (PREFIX=${PREFIX})..."

	for dep in mcp-glib crispy bacon gowl podomation libreclaw; do
		dep_dir="${SCRIPT_DIR}/deps/${dep}"
		if [[ ! -d "${dep_dir}" ]]; then
			echo "    SKIP ${dep} (${dep_dir} not found)"
			continue
		fi
		if [[ "${dep}" == "gowl" && "${platform}" == "macos" ]]; then
			echo "    SKIP gowl (Wayland not available on macOS)"
			continue
		fi
		if [[ "${dep}" == "gowl" && "${platform}" == "freebsd" ]]; then
			echo "    SKIP gowl (Wayland compositor limited on FreeBSD)"
			continue
		fi
		echo "    Building ${dep}..."
		${make_cmd} -C "${dep_dir}" clean all PREFIX="${PREFIX}"
		sudo ${make_cmd} -C "${dep_dir}" install PREFIX="${PREFIX}"
	done

	# whisper.cpp: NOT built here.  Recent whisper.cpp is CMake-only
	# and no longer ships a libwhisper.a Make target.  The cmacs
	# top-level `make -j$(nproc)' triggers its CMake build
	# automatically as a prerequisite of the whisper .o files (via
	# the $(CMACS_WHISPER_STATIC_LIB) rule in src/Makefile.in), with
	# the right -DCMAKE_C_STANDARD=11 etc. flags for the CMake 4.x +
	# GCC 16 feature-detection workaround.  Letting cmacs's build
	# drive it keeps the flags in exactly one place.

	# piper: OHF-Voice piper1-GPL is a Python package; the `piper'
	# console-script provides offline TTS (C-c v s).  It is OPTIONAL ---
	# a failure here must never abort install-deps, so every step below
	# is guarded and the block always falls through.
	#
	# We install into a DEDICATED VENV rather than `pip install --user'
	# or pipx because:
	#   - Debian/Ubuntu 24.04 and recent Fedora ship a PEP 668
	#     EXTERNALLY-MANAGED marker; `pip install [--user]' against the
	#     distro interpreter then errors with "externally-managed-
	#     environment".  A venv is not externally managed, so pip works.
	#   - pipx races piper-tts's scikit-build-core wheel when its backend
	#     is uv ("Pipx Internal Error: cannot find package 'piper-tts'
	#     metadata."), even though the wheel actually installed.
	# The venv lives under ~/.local/share/cmacs and its `piper' script is
	# symlinked onto PATH (~/.local/bin) so it is callable like a system
	# install.  Override the venv location with PIPER_VENV=.
	#
	# Prefer /usr/bin/python3 so we hit the distro interpreter, not a
	# brew/conda Python that may have moved out from under a cached venv.
	if ! command -v piper >/dev/null 2>&1; then
		_pyexe=""
		for cand in /usr/bin/python3 python3 python; do
			if command -v "$cand" >/dev/null 2>&1; then
				_pyexe="$cand"; break
			fi
		done
		_piper_venv="${PIPER_VENV:-${HOME}/.local/share/cmacs/piper-venv}"
		_piper_bindir="${HOME}/.local/bin"
		if [[ -z "$_pyexe" ]]; then
			echo "    WARNING: no python3 found; skipping piper-tts (optional TTS)."
		elif "$_pyexe" -m venv "$_piper_venv"; then
			echo "    Installing piper-tts into ${_piper_venv}..."
			"$_piper_venv/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
			if "$_piper_venv/bin/pip" install piper-tts; then
				mkdir -p "$_piper_bindir"
				ln -sf "$_piper_venv/bin/piper" "$_piper_bindir/piper"
				echo "    piper installed (linked at ${_piper_bindir}/piper)."
				case ":$PATH:" in
					*":${_piper_bindir}:"*) ;;
					*) echo "    NOTE: add ${_piper_bindir} to PATH to run \`piper'." ;;
				esac
			else
				echo "    WARNING: piper-tts install failed (optional --- TTS only); continuing."
			fi
		else
			echo "    WARNING: could not create a venv (install python3-venv?);"
			echo "             skipping piper-tts (optional TTS).  Manual install:"
			echo "                 ${_pyexe} -m venv ${_piper_venv}"
			echo "                 ${_piper_venv}/bin/pip install piper-tts"
		fi
	fi

	configure_ldconfig
}

# ── ldconfig / library path ──────────────────────────────────────────
# Libraries installed to PREFIX need to be discoverable at runtime.
# Linux: ldconfig    macOS: handled by brew/install_name    FreeBSD: ldconfig

configure_ldconfig () {
	local platform
	platform="$(detect_platform)"

	case "${platform}" in
		macos)
			echo "==> macOS: no ldconfig needed (dyld handles ${PREFIX}/lib)"
			return
			;;
		freebsd)
			local lib_dir="${PREFIX}/lib"
			echo "==> Configuring ldconfig for ${lib_dir}..."
			if ! ldconfig -r 2>/dev/null | grep -q "${lib_dir}"; then
				sudo sh -c "echo '${lib_dir}' >> /etc/ld-elf.conf"
			fi
			sudo ldconfig
			return
			;;
	esac

	# Linux
	local conf="/etc/ld.so.conf.d/local.conf"
	local lib_dir="${PREFIX}/lib64"

	if [[ ! -d "${lib_dir}" ]]; then
		lib_dir="${PREFIX}/lib"
	fi

	echo "==> Configuring ldconfig for ${lib_dir}..."
	if ! grep -qxF "${lib_dir}" "${conf}" 2>/dev/null; then
		echo "${lib_dir}" | sudo tee -a "${conf}" > /dev/null
	fi
	sudo ldconfig
}

# ── Main ─────────────────────────────────────────────────────────────

usage () {
	echo "Usage: $0 [--system|--from-source|--ldconfig|--list]"
	echo ""
	echo "  (no args)      Install everything (system + from-source)"
	echo "  --system       System packages only"
	echo "  --from-source  Build mcp-glib, crispy, bacon, gowl,"
	echo "                 podomation, libreclaw from deps/"
	echo "  --ldconfig     Configure library path (Linux/FreeBSD)"
	echo "  --list         Print package list for detected platform (dry run)"
	echo "  --check        Verify build deps (pkg-config modules + tools);"
	echo "                 exits non-zero if a REQUIRED one is missing"
	echo ""
	echo "Supported platforms:"
	echo "  Fedora / RHEL / CentOS Stream    (dnf)"
	echo "  Ubuntu / Debian / Mint / Pop!_OS (apt)"
	echo "  Arch / Manjaro / EndeavourOS     (pacman)"
	echo "  macOS                            (Homebrew)"
	echo "  FreeBSD                          (pkg)"
	echo ""
	echo "Configure CMacs with:"
	echo "  ./configure --with-pgtk --with-native-compilation \\"
	echo "    --with-json --with-tree-sitter \\"
	echo "    --with-cmacs-glib --with-cmacs-gi \\"
	echo "    --with-cmacs-crispy --with-cmacs-bacon --with-cmacs-gowl \\"
	echo "    --with-cmacs-podomation --with-cmacs-libreclaw \\"
	echo "    --with-cmacs-org-ex --with-cmacs-mcp"
}

list_packages () {
	local platform
	platform="$(detect_platform)"

	case "${platform}" in
		fedora)  set_packages_fedora ;;
		debian)  set_packages_debian ;;
		arch)    set_packages_arch ;;
		macos)   set_packages_macos ;;
		freebsd) set_packages_freebsd ;;
		*)
			echo "ERROR: Unsupported platform." >&2
			exit 1
			;;
	esac

	echo "Platform: ${platform}"
	echo "Install command: ${PKG_CMD}"
	echo ""
	echo "Build tools:     ${PKGS_BUILD[*]}"
	echo "Core libs:       ${PKGS_CORE[*]}"
	echo "GUI (pgtk):      ${PKGS_GUI[*]}"
	echo "Native comp:     ${PKGS_NCOMP[*]:-N/A}"
	echo "Image libs:      ${PKGS_IMAGE[*]}"
	echo "Text rendering:  ${PKGS_TEXT[*]}"
	echo "JSON:            ${PKGS_JSON[*]}"
	echo "Tree-sitter:     ${PKGS_TS[*]}"
	echo "Introspect:      ${PKGS_INTROSPECT[*]:-N/A}"
	echo "GLib/GI:         ${PKGS_GLIB[*]}"
	echo "Gowl (Wayland):  ${PKGS_GOWL[*]:-N/A}"
	echo "Video:           ${PKGS_VIDEO[*]:-N/A}"
	echo "Audio/STT/TTS:   ${PKGS_AUDIO[*]:-N/A}"
	echo "libregnum:       ${PKGS_LIBREGNUM[*]:-N/A}"
	echo "CAD:             ${PKGS_CAD[*]:-N/A}"
	echo "Office:          ${PKGS_OFFICE[*]:-N/A}"
	echo "dbexplorer:      ${PKGS_DBEXPLORER[*]:-N/A}"
	echo ""
	echo "From source (deps/): mcp-glib, crispy, bacon, gowl, podomation, libreclaw"
}

main () {
	local mode="${1:-all}"

	case "${mode}" in
		--system)
			install_system_deps
			;;
		--from-source)
			build_from_source
			;;
		--ldconfig)
			configure_ldconfig
			;;
		--check)
			check_build_deps
			;;
		--list)
			list_packages
			;;
		--help|-h)
			usage
			;;
		all)
			install_system_deps
			build_from_source
			;;
		*)
			echo "Unknown option: ${mode}" >&2
			usage
			exit 1
			;;
	esac

	echo "==> Done."
}

main "$@"
