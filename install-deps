#!/usr/bin/env bash
# install-deps — Install all CMacs build dependencies
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Supported platforms:
#   Fedora / RHEL / CentOS Stream (dnf)
#   Ubuntu / Debian (apt)
#   Arch Linux (pacman)
#   macOS (Homebrew)
#   FreeBSD (pkg)
#
# Usage:
#   ./install-deps              # install everything (system + from-source)
#   ./install-deps --system     # system packages only
#   ./install-deps --from-source # build crispy, bacon, gowl from deps/
#   ./install-deps --ldconfig   # configure /usr/local/lib64 (Linux only)
#
# On Fedora Silverblue / immutable systems:
#   sudo bootc override -- ./install-deps --system
# or install inside a dev distrobox.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="${PREFIX:-/usr/local}"

# ── Platform detection ───────────────────────────────────────────────

detect_platform () {
	if [[ "$(uname)" == "Darwin" ]]; then
		echo "macos"
		return
	fi
	if [[ "$(uname)" == "FreeBSD" ]]; then
		echo "freebsd"
		return
	fi
	if [[ -f /etc/os-release ]]; then
		# shellcheck source=/dev/null
		. /etc/os-release
		local id
		# ID first, then each word of ID_LIKE.  Distros derived from the
		# big three are legion (Omarchy, CachyOS, Garuda, Nobara,
		# Bazzite, Zorin, elementary, ...) and they all set ID to their
		# own name while declaring the parent in ID_LIKE.  Matching ID
		# alone reports "Unsupported platform" on every one of them.
		for id in "${ID:-}" ${ID_LIKE:-}; do
			[[ -n "${id}" ]] || continue
			case "${id}" in
				fedora|rhel|centos|rocky|alma)
					echo "fedora"
					return
					;;
				ubuntu|debian|linuxmint|pop)
					echo "debian"
					return
					;;
				arch|archlinux|manjaro|endeavouros)
					echo "arch"
					return
					;;
			esac
		done
		# Last resort: identify by the package manager actually present,
		# so an unlisted derivative still installs rather than aborting.
		if command -v pacman  >/dev/null 2>&1; then echo "arch";    return; fi
		if command -v apt-get >/dev/null 2>&1; then echo "debian";  return; fi
		if command -v dnf     >/dev/null 2>&1; then echo "fedora";  return; fi
		echo "unknown"
		return
	fi
	echo "unknown"
}

# ── Package availability ─────────────────────────────────────────────
#
# Every one of these package managers aborts the ENTIRE transaction when
# a single name is unknown (apt: "Unable to locate package"; pacman:
# "target not found"; dnf: "No match for argument").  A distro renaming
# or versioning one package would then leave the machine with none of the
# ~90 packages it could have installed, and the user bisecting the list
# by hand.  So: probe first, install what exists, report the rest.
#
# Probes read the LOCAL package index -- no network, no sudo.

pkg_available () {
	local platform="$1" pkg="$2"
	case "${platform}" in
		fedora)  [[ -n "$(dnf -q repoquery --qf '%{name}' -- "${pkg}" 2>/dev/null)" ]] ;;
		debian)  apt-cache show "${pkg}" >/dev/null 2>&1 ;;
		arch)    pacman -Si "${pkg}" >/dev/null 2>&1 ;;
		macos)   brew info "${pkg}" >/dev/null 2>&1 ;;
		freebsd) pkg search -e "${pkg}" >/dev/null 2>&1 ;;
		*)       return 1 ;;
	esac
}

# Echo the first candidate this host can actually install.  Used where a
# distro versions a package name (wlroots0.20 / wlroots0.19 / wlroots) so
# the list adapts instead of hard-coding one release's spelling.  When
# none match, echo the first candidate anyway -- partition_packages will
# then report it as missing rather than silently dropping the dependency.
pick_first_available () {
	local platform="$1"; shift
	local p
	for p in "$@"; do
		if pkg_available "${platform}" "${p}"; then
			echo "${p}"
			return 0
		fi
	done
	echo "$1"
}

# Split "$@" into the globals AVAIL and MISSING.
AVAIL=()
MISSING=()
partition_packages () {
	local platform="$1"; shift
	local p known=""
	AVAIL=(); MISSING=()

	# dnf repoquery costs ~0.3s per invocation, so batch the whole list
	# into one call.  Anything the batch does not confirm is re-probed
	# individually below, so a batch miss can never wrongly drop a
	# package -- it only makes the slow path rare.
	if [[ "${platform}" == "fedora" ]]; then
		known="$(dnf -q repoquery --qf '%{name}\n' -- "$@" 2>/dev/null | sort -u || true)"
	fi

	for p in "$@"; do
		if [[ -n "${known}" ]] && grep -qxF -- "${p}" <<<"${known}"; then
			AVAIL+=("${p}")
		elif pkg_available "${platform}" "${p}"; then
			AVAIL+=("${p}")
		else
			MISSING+=("${p}")
		fi
	done
}

# ── Package lists per platform ───────────────────────────────────────
#
# Grouped by function:
#   PKGS_BUILD    — compilers, autotools, pkg-config, texinfo
#   PKGS_CORE     — gnutls, ncurses, zlib
#   PKGS_GUI      — gtk3 (pgtk backend)
#   PKGS_NCOMP    — libgccjit (native compilation)
#   PKGS_IMAGE    — xpm, jpeg, gif, tiff, rsvg, webp, imagemagick
#                   (rsvg is REQUIRED for the cmacs-ink canvas overlay)
#   PKGS_TEXT     — libotf, m17n-lib
#   PKGS_JSON     — jansson
#   PKGS_TS       — tree-sitter
#   PKGS_GLIB     — glib, gobject-introspection
#   PKGS_GOWL     — wlroots, wayland, libinput, xkbcommon, pango, cairo
#   PKGS_LIBREGNUM — mesa GL + X11 devel libs (raylib's window/input
#                    backend is X11 even when we use the hidden-window
#                    + offscreen-FBO mode under Wayland).
#
# Android APK builds do NOT use this script — they run inside the
# `cmacs-android` container image (see Containerfile.android +
# `just android-image`).  The host needs only `podman` (or
# `docker`); JDK / Android SDK / NDK live in the image.

set_packages_fedora () {
	PKGS_BUILD=(autoconf automake gcc make pkgconf-pkg-config texinfo)
	PKGS_CORE=(gnutls-devel ncurses-devel zlib-devel)
	# webkit2gtk4.1-devel: --with-xwidgets (xwidget-webkit browser
	# buffers) AND --with-cmacs-gsurf (the embedded gsurf web browser,
	# which links libgsurf.a against the same GTK3/WebKit2GTK 4.1 stack
	# + yaml/json-glib from PKGS_GLIB).  Must be the 4.1 (GTK3 /
	# libsoup3) ABI -- the 6.0 package is GTK4-only and unusable from
	# Emacs pgtk (GTK3).
	PKGS_GUI=(gtk3-devel webkit2gtk4.1-devel)
	PKGS_NCOMP=(libgccjit-devel)
	PKGS_IMAGE=(libXpm-devel libjpeg-turbo-devel giflib-devel libtiff-devel
	            librsvg2-devel libwebp-devel ImageMagick-devel
	            wl-clipboard)  # imgedit clipboard fallback (--lrg/tty sessions)
	PKGS_TEXT=(libotf-devel m17n-lib-devel)
	PKGS_JSON=(jansson-devel)
	PKGS_TS=(libtree-sitter-devel)
	# Cintrospect (runtime C self-introspection): libdw + libelf
	# parse /proc/self/exe DWARF; libdebuginfod fetches split-debug
	# DIEs from the distro debuginfo server; binutils-devel
	# (libopcodes) is used by cpatch for prologue probe.
	PKGS_INTROSPECT=(elfutils-devel elfutils-debuginfod-client-devel
	                 binutils-devel)
	# readline-devel: crispy + bacon REPLs.  libgudev-devel: podomation's
	# gudev-1.0 (device module).  girepository-2.0.pc ships inside
	# glib2-devel on Fedora, so it needs no separate package here.
	PKGS_GLIB=(glib2-devel gobject-introspection-devel json-glib-devel
	           libsoup3-devel libdex-devel libetpan-devel libpq-devel
	           libssh2-devel libvirt-devel libyaml-devel libgudev-devel
	           readline-devel sqlite-devel cmark-devel)
	# wlroots: gowl builds against 0.19 OR 0.20 (newest present wins;
	# see deps/gowl/config.mk).  Prefer 0.20 -- it unlocks per-window
	# screencast capture (the "share a specific window" portal option);
	# 0.19 is monitor-only.  Fedora 44+ ships 0.20 as wlroots-devel.
	# Fedora 42/43 ship 0.19 only, as wlroots-devel there (the bare
	# package IS 0.19 on those releases), so wlroots-devel is correct
	# everywhere -- it resolves to whatever that release's latest
	# wlroots is.  (The wlroots0.19-devel compat package is only needed
	# to FORCE 0.19 on a 44+ host, which we no longer do by default.)
	#
	# Deliberately NOT probed the way Arch and Debian are: on those two
	# the unversioned name is either absent (Arch has no `wlroots') or
	# too old (Ubuntu 24.04's libwlroots-dev is 0.17).  On Fedora the
	# bare package always resolves to that release's newest wlroots,
	# which is exactly what gowl wants, and preferring a wlroots0.NN
	# compat package over it would install a different package than the
	# one that works today.
	local wlroots_pkg="wlroots-devel"
	# libxcb-devel + xcb-util-wm-devel provide the xcb/xcb-icccm
	# pkg-configs gowl's XWayland support needs at build time (else it
	# silently compiles out); xorg-x11-server-Xwayland is the rootless
	# X server gowl launches so X11 apps (e.g. raylib/GLFW) get a DISPLAY.
	# libdecor-devel (libdecor-0) is an optional gowl dep -- CSD when gowl
	# runs nested; pixman-devel is a direct wlroots build dep.
	PKGS_GOWL=("${wlroots_pkg}" wayland-devel wayland-protocols-devel
	           libinput-devel libxkbcommon-devel pango-devel cairo-devel
	           pixman-devel libdecor-devel
	           libxcb-devel xcb-util-wm-devel xorg-x11-server-Xwayland
	           libeis-devel            # EIS server for the InputCapture/RemoteDesktop portal (deskflow KVM)
	           xdg-desktop-portal-wlr  # wlroots ScreenCast/Screenshot portal backend (runtime)
	           slurp)                  # output/region chooser for the portal-wlr ScreenCast picker
	# cmacs-video: GStreamer + plugins-{base,good,bad,ugly} + libav.
	# plugins-bad provides rtspsrc (RTSP + RTSPS); libav gives software
	# H.264/H.265 fallback when hardware decode is unavailable.
	#
	# IMPORTANT: Fedora's gstreamer1-libav is built against the
	# *-free ffmpeg variant (libavcodec-free etc.), which strips
	# patent-encumbered codecs --- including H.264 Main and High
	# profile, the encoding nearly all real-world IP cameras use.
	# Without the swap below you'll see RTSP streams reach state
	# `paused' but never produce frames, with the error
	# "Missing element: H.264 (Main Profile) decoder" from
	# decodebin.
	#
	# To make H.264 Main/High work you need the full ffmpeg from
	# RPM Fusion (Fedora doesn't ship it for licensing reasons):
	#
	#   sudo dnf install \
	#     https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm
	#   sudo dnf swap ffmpeg-free ffmpeg --allowerasing
	#   rm -rf ~/.cache/gstreamer-1.0
	#
	# Verify with: gst-inspect-1.0 avdec_h264   (must print Factory Details, not "No such element").
	#
	# This is required for security-camera use cases (Unifi, Reolink,
	# Amcrest, Hikvision, Axis, etc.) where Main or High profile is
	# the default.  Public test streams encoded with the Baseline
	# profile will play without this swap.
	#
	# SEPARATE from GStreamer: the libregnum video EDITOR backend
	# (LrgVideoPlayer, built with FFMPEG=1 and used by --with-cmacs-vidstudio)
	# links the FFmpeg/libav development libraries directly.  Install with:
	#
	#   sudo dnf install ffmpeg-devel        # full ffmpeg (RPM Fusion)
	#   # or, for Fedora's stock *-free build:
	#   sudo dnf install libavformat-free-devel libavcodec-free-devel \
	#                    libavutil-free-devel libswscale-free-devel
	#
	# (Debian/Ubuntu: libavformat-dev libavcodec-dev libavutil-dev
	#  libswscale-dev; Arch/macOS-brew/FreeBSD: ffmpeg.)  Without them
	# libregnum still builds (FFMPEG=0); the player falls back to a stub.
	PKGS_VIDEO=(gstreamer1-devel gstreamer1-plugins-base-devel
	            gstreamer1-plugins-good gstreamer1-plugins-bad-free-devel
	            gstreamer1-plugins-bad-free-extras gstreamer1-plugins-ugly-free
	            gstreamer1-libav)
	# cmacs-audio: pipewiresrc (preferred) + pulsesrc (fallback).
	# cmake + gcc-c++: bundled whisper.cpp build under deps/.
	# pipx + espeak-ng: piper-tts install + phonemization backend.
	PKGS_AUDIO=(pipewire-devel pipewire-libs pulseaudio-libs-devel
	            cmake gcc-c++ pipx espeak-ng)
	# cmacs-libregnum: raylib (via graylib/libregnum) needs GL +
	# Xlib + the four input-related X11 libs even when we run it
	# in FLAG_WINDOW_HIDDEN mode -- raylib's InitWindow still
	# initialises X11 to construct the offscreen GL context.
	# mesa-libEGL-devel: gowl links egl.pc directly (mesa-libGL-devel
	# only carries gl.pc).  libpng-devel: required by gowl's MCP
	# screenshot path and by libregnum.
	PKGS_LIBREGNUM=(mesa-libGL-devel mesa-libEGL-devel libpng-devel
	                libX11-devel libXrandr-devel
	                libXcursor-devel libXinerama-devel libXi-devel)
	# libregnum scripting backends for the in-Emacs level editor: luajit-devel
	# (Lua), python3-devel (Python), gjs-devel (JavaScript; pulls mozjsNN-devel).
	# Optional -- without them only the crispy (compile-and-run C) backend is
	# available.  gjs additionally uses gobject-introspection-devel (in
	# PKGS_GLIB).  crispy comes from the deps/ submodule, no system package.
	# python3-gobject (PyGObject) is the runtime that lets Python scripts do
	# `from gi.repository import Libregnum` against the auto-built typelib (gjs
	# has its own GI loader built in).
	PKGS_LIBREGNUM+=(luajit-devel python3-devel gjs-devel python3-gobject)
	# cmacs-cad (cad-glib): OpenCASCADE is the system B-rep kernel
	# (never vendored; deps/cad-glib probes /usr/include/opencascade).
	# eigen3 is for the gated libfive f-rep kernel (CAD_FIVE=1); the
	# vendored solvespace solver uses its own in-tree Eigen.  cmake +
	# gcc-c++ (PKGS_AUDIO) build the vendored manifold/slvs kernels.
	PKGS_CAD=(opencascade-devel eigen3-devel)
	# cmacs-office (.docx/.xlsx/.pptx + .odt/.ods/.odp): every one of
	# those is a zip package of XML parts, so the whole subsystem needs
	# exactly two libraries.  libzip reads and writes the container --
	# and critically copies untouched members through WITHOUT
	# re-deflating them, which is what keeps the lossless round-trip
	# cheap.  libxml2 parses the parts; upstream Emacs already links it
	# for --with-xml2, but the -devel package is what we compile
	# against and it is not otherwise guaranteed to be present.
	PKGS_OFFICE=(libzip-devel libxml2-devel)

	# cmacs-dbexplorer talks to databases through orm-glib.  SQLite and
	# libpq already arrive with PKGS_GLIB above (Emacs needs sqlite for
	# --with-sqlite3), so the MariaDB connector is the only genuinely new
	# package here.  All three backends are optional at configure time:
	# a missing one narrows which URL schemes work, it does not fail the
	# build.
	PKGS_DBEXPLORER=(mariadb-connector-c-devel)
	PKG_CMD="sudo dnf install -y"
}

set_packages_debian () {
	PKGS_BUILD=(autoconf automake gcc make pkg-config texinfo)
	PKGS_CORE=(libgnutls28-dev libncurses-dev zlib1g-dev)
	PKGS_GUI=(libgtk-3-dev libwebkit2gtk-4.1-dev)
	# libgccjit is versioned per GCC release on Debian/Ubuntu
	# (libgccjit-13-dev on 24.04, -14 on trixie, -15 on newer).  Pinning
	# one number breaks native-compilation on every other release, so
	# match the compiler this machine will actually use, then walk
	# newest-down.  On a fresh host gcc is not installed yet (it arrives
	# in PKGS_BUILD, in this same transaction), so fall back to asking
	# apt which gcc-NN the `gcc' metapackage pulls in -- otherwise we
	# would pick a libgccjit from a different GCC release than the one
	# about to be installed.
	local gcc_major
	gcc_major="$(gcc -dumpversion 2>/dev/null | cut -d. -f1)"
	if [[ -z "${gcc_major}" ]]; then
		gcc_major="$(apt-cache depends gcc 2>/dev/null \
		             | sed -n 's/.*Depends: gcc-\([0-9][0-9]*\)$/\1/p' \
		             | head -1)"
	fi
	local ncomp_pkg
	ncomp_pkg="$(pick_first_available debian \
	             ${gcc_major:+"libgccjit-${gcc_major}-dev"} \
	             libgccjit-16-dev libgccjit-15-dev libgccjit-14-dev \
	             libgccjit-13-dev libgccjit-12-dev libgccjit-dev)"
	PKGS_NCOMP=("${ncomp_pkg}")
	PKGS_IMAGE=(libxpm-dev libjpeg-dev libgif-dev libtiff-dev
	            librsvg2-dev libwebp-dev libmagickwand-dev
	            wl-clipboard)  # imgedit clipboard fallback (--lrg/tty sessions)
	PKGS_TEXT=(libotf-dev libm17n-dev)
	PKGS_JSON=(libjansson-dev)
	PKGS_TS=(libtree-sitter-dev)
	PKGS_INTROSPECT=(libdw-dev libelf-dev libdebuginfod-dev
	                 binutils-dev)
	# libgirepository-2.0-dev: GLib's integrated GIRepository 2.0
	# (girepository-2.0.pc, <girepository/girepository.h>), used by the
	# bacon gobject_inspector module and libregnum's GI scripting backend.
	# Distinct from libgirepository1.0-dev (the legacy 1.0 API).  On Fedora
	# this header ships inside glib2-devel, so it only needs naming here.
	# In Ubuntu it lives in the 'universe' component.
	PKGS_GLIB=(libglib2.0-dev libgirepository1.0-dev libgirepository-2.0-dev
	           libjson-glib-dev libsoup-3.0-dev libdex-dev libetpan-dev
	           libpq-dev libssh2-1-dev libvirt-dev libyaml-dev
	           libgudev-1.0-dev libreadline-dev
	           libsqlite3-dev libcmark-dev)
	# libxcb1-dev + libxcb-icccm4-dev: XWayland build deps (xcb/xcb-icccm);
	# xwayland: the rootless X server gowl spawns for X11 clients.
	# Debian/Ubuntu version the wlroots -dev package per soname.  gowl
	# needs 0.19 or 0.20; the unversioned libwlroots-dev is 0.17 on
	# Ubuntu 24.04 (too old) but is the right name on releases that
	# ship a supported one, so probe newest-first and fall back.
	local wlroots_pkg
	wlroots_pkg="$(pick_first_available debian libwlroots-0.20-dev \
	                                    libwlroots-0.19-dev libwlroots-dev)"
	# Say so up front when this release carries no wlroots gowl can use.
	# Ubuntu 24.04's libwlroots-dev is 0.17: it installs cleanly and then
	# fails deep in the gowl build, which reads as a cmacs bug rather
	# than a too-old distro.
	if [[ "${wlroots_pkg}" == "libwlroots-dev" ]]; then
		echo "NOTE: no libwlroots-0.19/0.20-dev on this release."
		echo "      If libwlroots-dev is older than 0.19, gowl will not build:"
		echo "      build wlroots from source, or configure --without-cmacs-gowl."
		echo "      See doc_org/cmacs/build.org, \"Building on Ubuntu 24.04\"."
	fi
	# libwayland-bin carries wayland-scanner, which gowl runs to generate
	# its protocol sources (libwayland-dev usually pulls it in; name it so
	# a release that stops depending on it still works).
	PKGS_GOWL=("${wlroots_pkg}" libwayland-dev libwayland-bin wayland-protocols
	           libinput-dev libxkbcommon-dev libpango1.0-dev libcairo2-dev
	           libpixman-1-dev libdecor-0-dev libei-dev
	           libxcb1-dev libxcb-icccm4-dev xwayland
	           xdg-desktop-portal-wlr  # wlroots ScreenCast/Screenshot portal backend (runtime)
	           slurp)                  # output/region chooser for the portal-wlr ScreenCast picker
	PKGS_VIDEO=(libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev
	            gstreamer1.0-plugins-good gstreamer1.0-plugins-bad
	            gstreamer1.0-plugins-ugly gstreamer1.0-libav)
	PKGS_AUDIO=(libpipewire-0.3-dev libpulse-dev cmake g++
	            python3-venv pipx espeak-ng)
	# libegl1-mesa-dev: gowl links egl.pc (libgl1-mesa-dev is gl.pc only).
	# libpng-dev: gowl's MCP screenshot path and libregnum both need it.
	PKGS_LIBREGNUM=(libgl1-mesa-dev libegl1-mesa-dev libpng-dev
	                libx11-dev libxrandr-dev
	                libxcursor-dev libxinerama-dev libxi-dev)
	# cmacs-cad: OCCT splits into per-module -dev packages on Debian.
	PKGS_CAD=(libocct-foundation-dev libocct-modeling-data-dev
	          libocct-modeling-algorithms-dev libocct-data-exchange-dev
	          libeigen3-dev)
	# cmacs-office: zip container + XML parts.  See the Fedora block.
	PKGS_OFFICE=(libzip-dev libxml2-dev)
	# cmacs-dbexplorer: MariaDB connector.  See the Fedora block.
	PKGS_DBEXPLORER=(libmariadb-dev)
	PKG_CMD="sudo apt-get install -y"
	# NOTE: Ubuntu 24.04 (noble) ships wlroots 0.17, wayland 1.22,
	# wayland-protocols 1.34, and pixman 0.42 --- all too old for
	# gowl, which needs wlroots 0.19 or 0.20 (0.20 for per-window
	# screencast capture).  Build wlroots (and the rest of the stack)
	# from source -- see doc_org/cmacs/build.org "Building on Ubuntu
	# 24.04 / older hosts" and deps/gowl/docs/building.org "wlroots
	# version".  libdex-dev is also absent before 24.10; build libdex
	# from source on noble.
}

set_packages_arch () {
	PKGS_BUILD=(autoconf automake gcc make pkgconf texinfo)
	PKGS_CORE=(gnutls ncurses zlib)
	PKGS_GUI=(gtk3 webkit2gtk-4.1)
	PKGS_NCOMP=(libgccjit)
	PKGS_IMAGE=(libxpm libjpeg-turbo giflib libtiff librsvg libwebp imagemagick wl-clipboard)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	PKGS_INTROSPECT=(elfutils debuginfod binutils)
	# libgirepository: gobject-introspection-1.0.pc lives here on Arch
	# (gobject-introspection itself is the compiler/scanner).  readline:
	# crispy and bacon both link it for their REPLs.  libgudev: podomation's
	# gudev-1.0 (device module).  cmark -> libcmark.pc for libreclaw.
	PKGS_GLIB=(glib2 gobject-introspection libgirepository json-glib
	           libsoup3 libdex libetpan postgresql-libs libssh2 libvirt
	           libyaml libgudev readline sqlite cmark)
	# Arch has NO unversioned `wlroots' package -- only versioned ones
	# (wlroots0.19, wlroots0.20, ...).  gowl builds against 0.19 or 0.20
	# and prefers 0.20 (per-window screencast capture), so resolve the
	# newest supported one that this mirror actually carries.
	local wlroots_pkg
	wlroots_pkg="$(pick_first_available arch wlroots0.20 wlroots0.19 wlroots)"
	# libxcb + xcb-util-wm: XWayland build deps (xcb/xcb-icccm);
	# xorg-xwayland: the rootless X server gowl spawns for X11 clients.
	# libdecor + libei: optional gowl deps (libdecor-0 / libeis-1.0) --
	# CSD for nested sessions and the EIS InputCapture portal.  pixman is
	# a direct wlroots build dep.
	PKGS_GOWL=("${wlroots_pkg}"
	           wayland wayland-protocols libinput libxkbcommon pango cairo
	           pixman libdecor libei
	           libxcb xcb-util-wm xorg-xwayland
	           xdg-desktop-portal-wlr  # wlroots ScreenCast/Screenshot portal backend (runtime)
	           slurp)                  # output/region chooser for the portal-wlr ScreenCast picker
	PKGS_VIDEO=(gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad
	            gst-plugins-ugly gst-libav)
	PKGS_AUDIO=(pipewire libpulse cmake python-pipx espeak-ng)
	# libglvnd supplies gl.pc/egl.pc (mesa depends on it, but gowl and
	# libregnum link them directly, so name it).  libpng: gowl's MCP
	# screenshot path and libregnum both require libpng.pc.
	PKGS_LIBREGNUM=(mesa libglvnd libx11 libxrandr libxcursor libxinerama
	                libxi libpng)
	PKGS_CAD=(opencascade eigen)
	# cmacs-office: zip container + XML parts.  See the Fedora block.
	PKGS_OFFICE=(libzip libxml2)
	# cmacs-dbexplorer: MariaDB connector.  See the Fedora block.
	PKGS_DBEXPLORER=(mariadb-libs)
	PKG_CMD="sudo pacman -S --needed --noconfirm"
}

set_packages_macos () {
	PKGS_BUILD=(autoconf automake gcc make pkg-config texinfo)
	PKGS_CORE=(gnutls)
	PKGS_GUI=(gtk+3)
	PKGS_NCOMP=(libgccjit)
	PKGS_IMAGE=(libxpm jpeg-turbo giflib libtiff librsvg webp imagemagick)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	# Homebrew elfutils provides libdw + libelf; libdebuginfod is
	# absent on macOS but cintrospect degrades gracefully.
	PKGS_INTROSPECT=(elfutils)
	PKGS_GLIB=(glib gobject-introspection json-glib libsoup libdex
	           libetpan libpq libssh2 libvirt libyaml
	           sqlite cmark)
	PKGS_GOWL=()  # Wayland not available on macOS
	PKGS_VIDEO=(gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad
	            gst-plugins-ugly gst-libav)
	# pipewire is best-effort on macOS; cmacs-audio falls back to
	# coreaudiosrc (provided by gst-plugins-good) when pipewiresrc is
	# unavailable.  Set cmacs-audio-capture-source to 'coreaudio on macOS.
	PKGS_AUDIO=(pipewire cmake pipx espeak-ng)
	# macOS: raylib uses Cocoa, not X11.  No extra system deps
	# beyond Xcode CLT.  Leave empty so PKGS_LIBREGNUM exists.
	PKGS_LIBREGNUM=()
	PKGS_CAD=(opencascade eigen)
	# cmacs-office: zip container + XML parts.  See the Fedora block.
	# Homebrew's libxml2 is keg-only; pkg-config finds the SDK copy.
	PKGS_OFFICE=(libzip libxml2)
	# cmacs-dbexplorer: MariaDB connector.  See the Fedora block.
	PKGS_DBEXPLORER=(mariadb-connector-c)
	PKG_CMD="brew install"
}

set_packages_freebsd () {
	PKGS_BUILD=(autoconf automake gcc gmake pkgconf texinfo)
	PKGS_CORE=(gnutls ncurses)
	PKGS_GUI=(gtk3)
	PKGS_NCOMP=()  # libgccjit not readily available; native-comp optional
	PKGS_IMAGE=(libXpm jpeg-turbo giflib tiff librsvg2 webp ImageMagick7-nox11 wl-clipboard)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	PKGS_INTROSPECT=(elfutils)
	PKGS_GLIB=(glib gobject-introspection json-glib libsoup3 libdex
	           libetpan postgresql16-client libssh2 libvirt libyaml
	           sqlite3 cmark)
	PKGS_GOWL=()  # Wayland compositor support limited on FreeBSD
	PKGS_VIDEO=(gstreamer1 gstreamer1-plugins-core gstreamer1-plugins-good
	            gstreamer1-plugins-bad gstreamer1-plugins-ugly
	            gstreamer1-plugins-libav)
	PKGS_AUDIO=(pipewire pulseaudio cmake py39-pipx espeak-ng)
