	PKGS_BUILD=(autoconf automake gcc make pkgconf texinfo)
	PKGS_CORE=(gnutls ncurses zlib)
	PKGS_GUI=(gtk3 webkit2gtk-4.1)
	PKGS_NCOMP=(libgccjit)
	PKGS_IMAGE=(libxpm libjpeg-turbo giflib libtiff librsvg libwebp imagemagick)
	PKGS_TEXT=(libotf m17n-lib)
	PKGS_JSON=(jansson)
	PKGS_TS=(tree-sitter)
	PKGS_INTROSPECT=(elfutils debuginfod)
	PKGS_GLIB=(glib2 gobject-introspection json-glib libsoup3 libdex
	           libetpan postgresql-libs libssh2 libvirt libyaml
	           sqlite cmark)
	# libxcb + xcb-util-wm: XWayland build deps (xcb/xcb-icccm);
	# xorg-xwayland: the rootless X server gowl spawns for X11 clients.
	PKGS_GOWL=(wlroots wayland wayland-protocols libinput libxkbcommon pango cairo
	           libxcb xcb-util-wm xorg-xwayland
	           xdg-desktop-portal-wlr  # wlroots ScreenCast/Screenshot portal backend (runtime)
	           slurp)                  # output/region chooser for the portal-wlr ScreenCast picker
	PKGS_VIDEO=(gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad
	            gst-plugins-ugly gst-libav)
	PKGS_AUDIO=(pipewire libpulse cmake python-pipx espeak-ng)
	PKGS_LIBREGNUM=(mesa libx11 libxrandr libxcursor libxinerama libxi)
	PKGS_CAD=(opencascade eigen)
