#!/bin/bash
# install-wm — Install CMacs as a Wayland session for GDM/SDDM/greetd
#
# Usage:
#   sudo ./install-wm              # auto-detect binary path
#   sudo ./install-wm PREFIX=/usr/local  # use installed binary
#   ./install-wm --dry-run         # show what would be written
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

SESSION_DIR="/usr/share/wayland-sessions"
SESSION_FILE="${SESSION_DIR}/cmacs.desktop"
DRY_RUN=0
PREFIX=""
EMACS_BIN=""

for arg in "$@"; do
    case "$arg" in
        --dry-run)  DRY_RUN=1 ;;
        --remove)
            if [ -f "$SESSION_FILE" ]; then
                rm -v "$SESSION_FILE"
                echo "CMacs session removed."
            else
                echo "No CMacs session file found."
            fi
            exit 0
            ;;
        PREFIX=*)   PREFIX="${arg#PREFIX=}" ;;
        --help|-h)
            echo "Usage: sudo $0 [PREFIX=/usr/local] [--dry-run] [--remove]"
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 1
            ;;
    esac
done

# Detect emacs binary path
if [ -n "$PREFIX" ]; then
    # Installed mode: use PREFIX/bin/emacs
    EMACS_BIN="${PREFIX}/bin/emacs"
elif [ -x "$(dirname "$0")/src/emacs" ]; then
    # Repo mode: use absolute path to src/emacs
    EMACS_BIN="$(cd "$(dirname "$0")" && pwd)/src/emacs"
else
    echo "Error: Cannot find emacs binary." >&2
    echo "Run from the repo root or pass PREFIX=/usr/local" >&2
    exit 1
fi

if [ "$DRY_RUN" -eq 0 ] && [ ! -x "$EMACS_BIN" ]; then
    echo "Warning: $EMACS_BIN does not exist yet (build with 'make' first)." >&2
fi

# DesktopNames sets XDG_CURRENT_DESKTOP for the session.  Order is
# load-bearing and each name is here for a different consumer:
#
#   CMacs  -- first, for CMacs-specific lookups.
#   gowl   -- xdg-desktop-portal reads <desktop>-portals.conf, and the gowl
#             InputCapture/RemoteDesktop backend carries UseIn=gowl.  This
#             is what lets deskflow's KVM input capture work under --gowl.
#   GNOME  -- LAST, and only as a fallback for software that pattern-matches
#             this variable against a hardcoded list of desktops it knows.
#
# That last one is not cosmetic.  Chromium -- and so every Electron app,
# including Claude Desktop, VS Code and Slack -- picks its password store
# by splitting XDG_CURRENT_DESKTOP on ':' and comparing each name against
# a fixed set (GNOME, KDE, XFCE, Unity, Cinnamon, Pantheon, UKUI, LXQt).
# A session naming none of them resolves to DESKTOP_ENVIRONMENT_OTHER, and
# key_storage_util_linux then selects the PLAINTEXT backend rather than
# libsecret.  The symptom is an app announcing it cannot save your session
# and you will have to log in again next time -- and it applies equally to
# secrets it ALREADY stored while running under GNOME, because the backend
# changed underneath them.  (Chromium records this: its Local State grows
# an "os_crypt":{"portal":{"prev_desktop":"GNOME"}} entry, and switching
# desktops is exactly what invalidates it.)
#
# GNOME goes last so every first-match consumer still resolves to gowl:
# xdg-desktop-portal picks gowl-portals.conf, being the first name here
# with a matching <name>-portals.conf, and UseIn matching hits gowl before
# GNOME.  gowl runs no XDG autostart .desktop files -- its autostart module
# spawns an explicit list of commands from the config -- so nothing here
# can trip an OnlyShowIn=GNOME entry.
#
# The keyring itself needs nothing: gnome-keyring-daemon is started by
# pam_gnome_keyring at login and owns org.freedesktop.secrets no matter
# which compositor is in front of it.  Only the advertised desktop name
# was wrong.
# The launcher does NOT `exec' emacs: when the compositor exits -- cleanly
# OR by crash (SIGSEGV) -- the surviving shell must stop the session target
# the compositor pulled in (gowl-session.target -> graphical-session.target).
# Otherwise the persistent user@ manager keeps graphical-session.target
# active, and the NEXT login (even GNOME) aborts in
# gnome-session-init-worker with "A graphical session is already running!",
# wedging all logins until a reboot.  `systemctl ... stop' is best-effort
# (|| true) so a wedged manager can't block logout.
DESKTOP_ENTRY="[Desktop Entry]
Name=CMacs
Comment=CMacs — Emacs as a Wayland Compositor
Exec=/bin/bash -lc '${EMACS_BIN} --gowl; systemctl --user stop gowl-session.target graphical-session.target 2>/dev/null || true'
Type=Application
DesktopNames=CMacs:gowl:GNOME"

if [ "$DRY_RUN" -eq 1 ]; then
    echo "Would write to: $SESSION_FILE"
    echo "---"
    echo "$DESKTOP_ENTRY"
    echo "---"
    echo "Binary: $EMACS_BIN"
    exit 0
fi

# Must be root to write to /usr/share
if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Must run as root (use sudo)." >&2
    exit 1
fi

mkdir -p "$SESSION_DIR"
echo "$DESKTOP_ENTRY" > "$SESSION_FILE"
echo "Installed CMacs Wayland session:"
echo "  Session file: $SESSION_FILE"
echo "  Binary: $EMACS_BIN"
echo ""
echo "Log out and select 'CMacs' from your display manager."
