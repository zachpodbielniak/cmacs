# Note that this file is edited by msdos/sed1v2.inp for MSDOS.  That
# script may need modifying in sync with changes made here.  Try to
# avoid shell-ism because the DOS build has to use the DOS shell.

SHELL = @SHELL@

# Here are the things that we expect ../configure to edit.
# We use $(srcdir) explicitly in dependencies so as not to depend on VPATH.
srcdir = @srcdir@
top_srcdir = @top_srcdir@
top_builddir = @top_builddir@
# MinGW CPPFLAGS may use this.
abs_top_srcdir=@abs_top_srcdir@
VPATH = $(srcdir)

# Set these to 'not-set' when they are not set from top-level to please
# 'load--fixup-all-elns' (bug#70842).
ELN_DESTDIR=not-set
BIN_DESTDIR=not-set

# This is not empty if this is a Makefile that will be copied to
# cross/src.
XCONFIGURE = @XCONFIGURE@

ifneq ($(XCONFIGURE),)
vpath %.c := $(srcdir)
vpath %.h := $(srcdir)
endif

vpath %.c $(srcdir)/../cmacs/core $(srcdir)/../cmacs/glib $(srcdir)/../cmacs/gobject \
          $(srcdir)/../cmacs/dbus \
          $(srcdir)/../cmacs/gi $(srcdir)/../cmacs/crispy \
          $(srcdir)/../cmacs/bacon $(srcdir)/../cmacs/gowl \
          $(srcdir)/../cmacs/podomation \
          $(srcdir)/../cmacs/org-ex \
          $(srcdir)/../cmacs/mcp \
          $(srcdir)/../cmacs/cintrospect \
          $(srcdir)/../cmacs/cpatch \
          $(srcdir)/../cmacs/compat
vpath %.h $(srcdir)/../cmacs/core $(srcdir)/../cmacs/glib $(srcdir)/../cmacs/gobject \
          $(srcdir)/../cmacs/dbus \
          $(srcdir)/../cmacs/gi $(srcdir)/../cmacs/crispy \
          $(srcdir)/../cmacs/bacon $(srcdir)/../cmacs/gowl \
          $(srcdir)/../cmacs/podomation \
          $(srcdir)/../cmacs/org-ex \
          $(srcdir)/../cmacs/mcp \
          $(srcdir)/../cmacs/cintrospect \
          $(srcdir)/../cmacs/cpatch \
          $(srcdir)/../cmacs/compat

# abs_top_builddir is the name of the toplevel build directory under
# cross-compiled builds.
abs_top_builddir = @abs_top_builddir@

CC = @CC@
CXX = @CXX@
CFLAGS = @CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
EXEEXT = @EXEEXT@
version = @version@
MKDIR_P = @MKDIR_P@
AWK = @AWK@
# Don't use LIBS.  configure puts stuff in it that either shouldn't be
# linked with Emacs or is duplicated by the other stuff below.
# LIBS = @LIBS@
LIBOBJS = @LIBOBJS@

lispsource = $(top_srcdir)/lisp
lib = ../lib
hostlib = $(top_builddir)/lib
libsrc = ../lib-src
etc = ../etc
oldXMenudir = ../oldXMenu
lwlibdir = ../lwlib

# Configuration files for .o files to depend on.
config_h = config.h $(srcdir)/conf_post.h

HAVE_NATIVE_COMP = @HAVE_NATIVE_COMP@

## ns-app if NS self contained app, else empty.
OTHER_FILES = @OTHER_FILES@

## Flags to pass for profiling builds
PROFILING_CFLAGS = @PROFILING_CFLAGS@

## Flags to pass to the compiler to enable build warnings
WARN_CFLAGS = @WARN_CFLAGS@
WERROR_CFLAGS = @WERROR_CFLAGS@

## Machine-specific CFLAGS.
C_SWITCH_MACHINE=@C_SWITCH_MACHINE@
## System-specific CFLAGS.
C_SWITCH_SYSTEM=@C_SWITCH_SYSTEM@

GNUSTEP_CFLAGS=@GNUSTEP_CFLAGS@
PNG_CFLAGS=@PNG_CFLAGS@

## Define C_SWITCH_X_SITE to contain any special flags your compiler
## may need to deal with X Windows.  For instance, if you've defined
## HAVE_X_WINDOWS and your X include files aren't in a place that your
## compiler can find on its own, you might want to add "-I/..." or
## something similar.  This is normally set by configure.
C_SWITCH_X_SITE=@C_SWITCH_X_SITE@

## Define LD_SWITCH_X_SITE to contain any special flags your loader
## may need to deal with X Windows.  For instance, if your X libraries
## aren't in a place that your loader can find on its own, you might
## want to add "-L/..." or something similar.  Only used if
## HAVE_X_WINDOWS.
## FIXME? configure sets a value for this, but it has never been
## substituted in this or any other Makefile. Cf C_SWITCH_X_SITE.
LD_SWITCH_X_SITE=

## This must come before LD_SWITCH_SYSTEM.
## If needed, a -rpath option that says where to find X windows at run time.
LD_SWITCH_X_SITE_RPATH=@LD_SWITCH_X_SITE_RPATH@

## System-specific LDFLAGS.
LD_SWITCH_SYSTEM=@LD_SWITCH_SYSTEM@

## This holds any special options for linking temacs only (i.e., not
## used by configure).
LD_SWITCH_SYSTEM_TEMACS=@LD_SWITCH_SYSTEM_TEMACS@

## Flags to pass to ld only for temacs.
TEMACS_LDFLAGS = $(LD_SWITCH_SYSTEM) $(LD_SWITCH_SYSTEM_TEMACS)

## Some systems define this to request special libraries.
LIBS_SYSTEM=@LIBS_SYSTEM@

## -lm, or empty.
LIB_MATH=@LIB_MATH@

## -lpthread, or empty.
LIB_PTHREAD=@LIB_PTHREAD@

LIBIMAGE=@LIBTIFF@ @LIBJPEG@ @LIBPNG@ @LIBGIF@ @LIBXPM@ @WEBP_LIBS@

GIF_CFLAGS=@GIF_CFLAGS@
JPEG_CFLAGS=@JPEG_CFLAGS@
TIFF_CFLAGS=@TIFF_CFLAGS@

XCB_LIBS=@XCB_LIBS@
XFT_LIBS=@XFT_LIBS@
XRENDER_LIBS=@XRENDER_LIBS@
LIBX_EXTRA=-lX11 $(XCB_LIBS) $(XFT_LIBS) $(XRENDER_LIBS)

FONTCONFIG_CFLAGS = @FONTCONFIG_CFLAGS@
FONTCONFIG_LIBS = @FONTCONFIG_LIBS@
FREETYPE_CFLAGS = @FREETYPE_CFLAGS@
FREETYPE_LIBS = @FREETYPE_LIBS@
HARFBUZZ_CFLAGS = @HARFBUZZ_CFLAGS@
HARFBUZZ_LIBS = @HARFBUZZ_LIBS@
LIBOTF_CFLAGS = @LIBOTF_CFLAGS@
LIBOTF_LIBS = @LIBOTF_LIBS@
M17N_FLT_CFLAGS = @M17N_FLT_CFLAGS@
M17N_FLT_LIBS = @M17N_FLT_LIBS@

LIB_ACL=@LIB_ACL@
CLOCK_TIME_LIB=@CLOCK_TIME_LIB@
EUIDACCESS_LIBGEN=@EUIDACCESS_LIBGEN@
NANOSLEEP_LIB=@NANOSLEEP_LIB@
QCOPY_ACL_LIB=@QCOPY_ACL_LIB@
TIMER_TIME_LIB=@TIMER_TIME_LIB@

DBUS_CFLAGS = @DBUS_CFLAGS@
DBUS_LIBS = @DBUS_LIBS@
## dbusbind.o if HAVE_DBUS, else empty.
DBUS_OBJ = @DBUS_OBJ@

## xwidgets.o if HAVE_XWIDGETS, else empty.
XWIDGETS_OBJ = @XWIDGETS_OBJ@

LIB_EXECINFO=@LIB_EXECINFO@

SETTINGS_CFLAGS = @SETTINGS_CFLAGS@
SETTINGS_LIBS = @SETTINGS_LIBS@

## gtkutil.o if USE_GTK, else empty.
GTK_OBJ=@GTK_OBJ@

## inotify.o if HAVE_INOTIFY.
## kqueue.o if HAVE_KQUEUE.
## gfilenotify.o if HAVE_GFILENOTIFY.
## w32notify.o if HAVE_W32NOTIFY.
NOTIFY_OBJ = @NOTIFY_OBJ@
NOTIFY_CFLAGS = @NOTIFY_CFLAGS@
NOTIFY_LIBS = @NOTIFY_LIBS@

## -ltermcap, or -lncurses, or -lcurses, or "".
LIBS_TERMCAP=@LIBS_TERMCAP@
## terminfo.o if TERMINFO, else (on MS-DOS only: termcap.o +) tparam.o.
TERMCAP_OBJ=@TERMCAP_OBJ@

LIBXMU=@LIBXMU@

LIBXSM=@LIBXSM@

LIBXTR6=@LIBXTR6@

## $(LIBXMU) -lXt $(LIBXTR6) -lXext if USE_X_TOOLKIT, else $(LIBXSM).
## Only used if HAVE_X_WINDOWS.
LIBXT_OTHER=@LIBXT_OTHER@

## If !HAVE_X11 || USE_GTK, empty.
## Else if USE_X_TOOLKIT, $(lwlibdir)/liblw.a.
## Else $(oldXMenudir)/libXMenu11.a.
LIBXMENU=@LIBXMENU@

## xmenu.o if HAVE_X_WINDOWS, else empty.
XMENU_OBJ=@XMENU_OBJ@
## xterm.o xfns.o xselect.o xrdb.o xsmfns.o xsettings.o if
## HAVE_X_WINDOWS, else empty.
XOBJ=@XOBJ@

# xgselect.o if linking with GLib, else empty
XGSELOBJ=@XGSELOBJ@

TOOLKIT_LIBW=@TOOLKIT_LIBW@

## Only used if HAVE_X11, in LIBX_OTHER.
LIBXT=$(TOOLKIT_LIBW) $(LIBXT_OTHER)

## If HAVE_X11, $(LIBXT) $(LIBX_EXTRA), else empty.
LIBX_OTHER=@LIBX_OTHER@

## LIBXMENU is empty if !HAVE_X_WINDOWS.
## LD_SWITCH_X_SITE should not be used if not using X, but nothing
## sets it at present, and if something ever does, it should be
## configure, which should set it to nil in non-X builds.
LIBX_BASE=$(LIBXMENU) $(LD_SWITCH_X_SITE)

## Used only for GNUstep.
LIBS_GNUSTEP=$(patsubst -specs=%-hardened-ld,,@LIBS_GNUSTEP@)

LIBSOUND= @LIBSOUND@
CFLAGS_SOUND= @CFLAGS_SOUND@

RSVG_LIBS= @RSVG_LIBS@
RSVG_CFLAGS= @RSVG_CFLAGS@

WEBP_CFLAGS= @WEBP_CFLAGS@

WEBKIT_LIBS= @WEBKIT_LIBS@
WEBKIT_CFLAGS= @WEBKIT_CFLAGS@

CAIRO_LIBS= @CAIRO_LIBS@
CAIRO_CFLAGS= @CAIRO_CFLAGS@

IMAGEMAGICK_LIBS= @IMAGEMAGICK_LIBS@
IMAGEMAGICK_CFLAGS= @IMAGEMAGICK_CFLAGS@

LIBXML2_LIBS = @LIBXML2_LIBS@
LIBXML2_CFLAGS = @LIBXML2_CFLAGS@

SQLITE3_LIBS = @SQLITE3_LIBS@
SQLITE3_CFLAGS = @SQLITE3_CFLAGS@

GETADDRINFO_A_LIBS = @GETADDRINFO_A_LIBS@

LCMS2_LIBS = @LCMS2_LIBS@
LCMS2_CFLAGS = @LCMS2_CFLAGS@

LIBZ = @LIBZ@

## system-specific libs for dynamic modules, else empty
LIBMODULES = @LIBMODULES@
## emacs-module.o if modules enabled, else empty
MODULES_OBJ = @MODULES_OBJ@

XRANDR_LIBS = @XRANDR_LIBS@
XRANDR_CFLAGS = @XRANDR_CFLAGS@

XINERAMA_LIBS = @XINERAMA_LIBS@
XINERAMA_CFLAGS = @XINERAMA_CFLAGS@

XFIXES_LIBS = @XFIXES_LIBS@
XFIXES_CFLAGS = @XFIXES_CFLAGS@

XINPUT_LIBS = @XINPUT_LIBS@
XINPUT_CFLAGS = @XINPUT_CFLAGS@

XSYNC_LIBS = @XSYNC_LIBS@
XSYNC_CFLAGS = @XSYNC_CFLAGS@

XDBE_LIBS = @XDBE_LIBS@
XDBE_CFLAGS = @XDBE_CFLAGS@

XCOMPOSITE_LIBS = @XCOMPOSITE_LIBS@
XCOMPOSITE_CFLAGS = @XCOMPOSITE_CFLAGS@

XSHAPE_LIBS = @XSHAPE_LIBS@
XSHAPE_CFLAGS = @XSHAPE_CFLAGS@

## widget.o if USE_X_TOOLKIT, otherwise empty.
WIDGET_OBJ=@WIDGET_OBJ@

## cygw32.o if CYGWIN, otherwise empty.
CYGWIN_OBJ=@CYGWIN_OBJ@

## fontset.o fringe.o image.o if we have any window system
WINDOW_SYSTEM_OBJ=@WINDOW_SYSTEM_OBJ@

## dosfns.o msdos.o w16select.o if MSDOS.
MSDOS_OBJ =
## w16select.o termcap.o if MSDOS && HAVE_X_WINDOWS.
MSDOS_X_OBJ =

NS_OBJ=@NS_OBJ@
## nsterm.o nsfns.o nsmenu.o nsselect.o nsimage.o ns_fontfile if HAVE_NS.
NS_OBJC_OBJ=@NS_OBJC_OBJ@
## Used only for GNUstep.
GNU_OBJC_CFLAGS=$(patsubst -specs=%-hardened-cc1,,@GNU_OBJC_CFLAGS@)
## w32fns.o w32menu.c w32reg.o fringe.o fontset.o w32font.o w32term.o
## w32xfns.o w32select.o image.o w32uniscribe.o w32cygwinx.o if HAVE_W32,
## w32cygwinx.o if CYGWIN but not HAVE_W32, else empty.
W32_OBJ=@W32_OBJ@
## -lkernel32 -luser32 -lusp10 -lgdi32 -lole32 -lcomdlg32 -lcomctl32
## -lwinspool if HAVE_W32,
## -lkernel32 if CYGWIN but not HAVE_W32, else empty.
W32_LIBS=@W32_LIBS@

PGTK_OBJ=@PGTK_OBJ@
PGTK_LIBS=@PGTK_LIBS@

# CMACS
# Always linked, regardless of which cmacs features are enabled: the
# IS-CMACS-* feature-flag registry (cmacs/core/cmacs-features.c).
CMACS_CORE_OBJ = cmacs-features.o
CMACS_GLIB_OBJ = @CMACS_GLIB_OBJ@
CMACS_GLIB_CFLAGS = @CMACS_GLIB_CFLAGS@
CMACS_GLIB_LIBS = @CMACS_GLIB_LIBS@
CMACS_GI_OBJ = @CMACS_GI_OBJ@
CMACS_GI_CFLAGS = @CMACS_GI_CFLAGS@
CMACS_GI_LIBS = @CMACS_GI_LIBS@
CMACS_CRISPY_OBJ = @CMACS_CRISPY_OBJ@
CMACS_CRISPY_CFLAGS = @CMACS_CRISPY_CFLAGS@
CMACS_CRISPY_LIBS = @CMACS_CRISPY_LIBS@
CMACS_CRISPY_BUNDLED = @CMACS_CRISPY_BUNDLED@
CMACS_BACON_OBJ = @CMACS_BACON_OBJ@
CMACS_BACON_CFLAGS = @CMACS_BACON_CFLAGS@
CMACS_BACON_LIBS = @CMACS_BACON_LIBS@
CMACS_BACON_BUNDLED = @CMACS_BACON_BUNDLED@
CMACS_GOWL_OBJ = @CMACS_GOWL_OBJ@
CMACS_GOWL_CFLAGS = @CMACS_GOWL_CFLAGS@
CMACS_GOWL_LIBS = @CMACS_GOWL_LIBS@
CMACS_GOWL_BUNDLED = @CMACS_GOWL_BUNDLED@
CMACS_PODOMATION_OBJ = @CMACS_PODOMATION_OBJ@
CMACS_PODOMATION_CFLAGS = @CMACS_PODOMATION_CFLAGS@
CMACS_PODOMATION_LIBS = @CMACS_PODOMATION_LIBS@
CMACS_PODOMATION_BUNDLED = @CMACS_PODOMATION_BUNDLED@
CMACS_LIBRECLAW_OBJ = @CMACS_LIBRECLAW_OBJ@
CMACS_LIBRECLAW_CFLAGS = @CMACS_LIBRECLAW_CFLAGS@
CMACS_LIBRECLAW_LIBS = @CMACS_LIBRECLAW_LIBS@
CMACS_LIBRECLAW_BUNDLED = @CMACS_LIBRECLAW_BUNDLED@
CMACS_AI_OBJ = @CMACS_AI_OBJ@
CMACS_AI_CFLAGS = @CMACS_AI_CFLAGS@
CMACS_AI_LIBS = @CMACS_AI_LIBS@
CMACS_AI_BRIGADE_OBJ = @CMACS_AI_BRIGADE_OBJ@
CMACS_AI_BRIGADE_CFLAGS = @CMACS_AI_BRIGADE_CFLAGS@
CMACS_AI_BRIGADE_LIBS = @CMACS_AI_BRIGADE_LIBS@
CMACS_LIBREGNUM_OBJ = @CMACS_LIBREGNUM_OBJ@
CMACS_LIBREGNUM_CFLAGS = @CMACS_LIBREGNUM_CFLAGS@
CMACS_LIBREGNUM_LIBS = @CMACS_LIBREGNUM_LIBS@
CMACS_LRGTERM_OBJ = @CMACS_LRGTERM_OBJ@
CMACS_LRGTERM_CFLAGS = @CMACS_LRGTERM_CFLAGS@
CMACS_LRGTERM_LIBS = @CMACS_LRGTERM_LIBS@
CMACS_IMGEDIT_OBJ = @CMACS_IMGEDIT_OBJ@
CMACS_IMGEDIT_CFLAGS = @CMACS_IMGEDIT_CFLAGS@
CMACS_IMGEDIT_LIBS = @CMACS_IMGEDIT_LIBS@
CMACS_CALCULATOR_OBJ = @CMACS_CALCULATOR_OBJ@
CMACS_CALCULATOR_CFLAGS = @CMACS_CALCULATOR_CFLAGS@
CMACS_CALCULATOR_LIBS = @CMACS_CALCULATOR_LIBS@
CMACS_LSP_OBJ = @CMACS_LSP_OBJ@
CMACS_LSP_CFLAGS = @CMACS_LSP_CFLAGS@
CMACS_LSP_LIBS = @CMACS_LSP_LIBS@
CMACS_VIDSTUDIO_OBJ = @CMACS_VIDSTUDIO_OBJ@
CMACS_VIDSTUDIO_CFLAGS = @CMACS_VIDSTUDIO_CFLAGS@
CMACS_VIDSTUDIO_LIBS = @CMACS_VIDSTUDIO_LIBS@
CMACS_GNUSEYE_OBJ = @CMACS_GNUSEYE_OBJ@
CMACS_GNUSEYE_CFLAGS = @CMACS_GNUSEYE_CFLAGS@
CMACS_GNUSEYE_LIBS = @CMACS_GNUSEYE_LIBS@
CMACS_GRAPHCORE_OBJ = @CMACS_GRAPHCORE_OBJ@
CMACS_ROAMGRAPH_OBJ = @CMACS_ROAMGRAPH_OBJ@
CMACS_ROAMGRAPH_CFLAGS = @CMACS_ROAMGRAPH_CFLAGS@
CMACS_ROAMGRAPH_LIBS = @CMACS_ROAMGRAPH_LIBS@
CMACS_SECONDBRAIN_OBJ = @CMACS_SECONDBRAIN_OBJ@
CMACS_SECONDBRAIN_CFLAGS = @CMACS_SECONDBRAIN_CFLAGS@
CMACS_SECONDBRAIN_LIBS = @CMACS_SECONDBRAIN_LIBS@
CMACS_OFFICE_OBJ = @CMACS_OFFICE_OBJ@
CMACS_OFFICE_CFLAGS = @CMACS_OFFICE_CFLAGS@
CMACS_OFFICE_LIBS = @CMACS_OFFICE_LIBS@
CMACS_DBEXPLORER_OBJ = @CMACS_DBEXPLORER_OBJ@
CMACS_DBEXPLORER_CFLAGS = @CMACS_DBEXPLORER_CFLAGS@
CMACS_DBEXPLORER_LIBS = @CMACS_DBEXPLORER_LIBS@
CMACS_DBEXPLORER_ORM_FLAGS = @CMACS_DBEXPLORER_ORM_FLAGS@
CMACS_LRGSCRIPT_OBJ = @CMACS_LRGSCRIPT_OBJ@
CMACS_LRGSCRIPT_CFLAGS = @CMACS_LRGSCRIPT_CFLAGS@
CMACS_LRGSCRIPT_LIBS = @CMACS_LRGSCRIPT_LIBS@
CMACS_CAD_OBJ = @CMACS_CAD_OBJ@
CMACS_CAD_CFLAGS = @CMACS_CAD_CFLAGS@
CMACS_CAD_LIBS = @CMACS_CAD_LIBS@
CMACS_CAD_LIBREGNUM_FLAGS = @CMACS_CAD_LIBREGNUM_FLAGS@
CMACS_SCREENSAVER_OBJ = @CMACS_SCREENSAVER_OBJ@
CMACS_SCREENSAVER_CFLAGS = @CMACS_SCREENSAVER_CFLAGS@
CMACS_SCREENSAVER_LIBS = @CMACS_SCREENSAVER_LIBS@
CMACS_GSURF_OBJ = @CMACS_GSURF_OBJ@
CMACS_GSURF_CFLAGS = @CMACS_GSURF_CFLAGS@
CMACS_GSURF_LIBS = @CMACS_GSURF_LIBS@
CMACS_GSURF_BUNDLED = @CMACS_GSURF_BUNDLED@
CMACS_GSURF_LRG = @CMACS_GSURF_LRG@
## gsurf libregnum backend (emacs --lrg): compile the cmacs glue object and
## define HAVE_CMACS_GSURF_LRG for the gsurf + lrgterm TUs (the only ones that
## reference it -- via their per-target CFLAGS, so no config.h-wide rebuild).
ifeq ($(CMACS_GSURF_LRG),yes)
CMACS_GSURF_OBJ += cmacs-gsurf-lrg.o
CMACS_GSURF_CFLAGS += -DHAVE_CMACS_GSURF_LRG=1
CMACS_LRGTERM_CFLAGS += -DHAVE_CMACS_GSURF_LRG=1
endif
CMACS_ORG_EX_OBJ = @CMACS_ORG_EX_OBJ@
CMACS_ORG_EX_CFLAGS = @CMACS_ORG_EX_CFLAGS@
CMACS_ORG_EX_LIBS = @CMACS_ORG_EX_LIBS@
CMACS_MCP_OBJ = @CMACS_MCP_OBJ@
CMACS_MCP_CFLAGS = @CMACS_MCP_CFLAGS@
CMACS_MCP_LIBS = @CMACS_MCP_LIBS@
CMACS_MCP_BUNDLED = @CMACS_MCP_BUNDLED@
## CMACS: in-house dep build type (release|debug) + extra make flags.
## With --enable-cmacs-deps-debug these become "debug" / "DEBUG=1" so cmacs
## builds and links the deps' build/debug (-O0 -g3) artifacts; otherwise
## "release" / empty (unchanged behavior).  See configure.ac.
CMACS_DEP_BUILDTYPE = @CMACS_DEP_BUILDTYPE@
CMACS_DEP_MAKEFLAGS = @CMACS_DEP_MAKEFLAGS@
CMACS_CINTROSPECT_OBJ = @CMACS_CINTROSPECT_OBJ@
CMACS_CINTROSPECT_CFLAGS = @CMACS_CINTROSPECT_CFLAGS@
CMACS_CINTROSPECT_LIBS = @CMACS_CINTROSPECT_LIBS@
CMACS_CPATCH_OBJ = @CMACS_CPATCH_OBJ@
CMACS_CPATCH_LIBS = @CMACS_CPATCH_LIBS@
CMACS_VIDEO_OBJ = @CMACS_VIDEO_OBJ@
CMACS_VIDEO_CFLAGS = @CMACS_VIDEO_CFLAGS@
CMACS_VIDEO_LIBS = @CMACS_VIDEO_LIBS@
CMACS_AUDIO_OBJ = @CMACS_AUDIO_OBJ@
CMACS_AUDIO_CFLAGS = @CMACS_AUDIO_CFLAGS@
CMACS_AUDIO_LIBS = @CMACS_AUDIO_LIBS@
CMACS_WHISPER_OBJ = @CMACS_WHISPER_OBJ@
CMACS_WHISPER_CFLAGS = @CMACS_WHISPER_CFLAGS@
CMACS_WHISPER_LIBS = @CMACS_WHISPER_LIBS@
CMACS_WHISPER_BUNDLED = @CMACS_WHISPER_BUNDLED@
CMACS_PIPER_OBJ = @CMACS_PIPER_OBJ@
CMACS_PIPER_CFLAGS = @CMACS_PIPER_CFLAGS@
CMACS_PIPER_LIBS = @CMACS_PIPER_LIBS@
CMACS_API_DIR = @CMACS_API_DIR@
CMACS_INTERNAL_CFLAGS = -I$(srcdir)/../cmacs/core \
                        -I$(srcdir)/../cmacs/glib -I$(srcdir)/../cmacs/gobject \
                        -I$(srcdir)/../cmacs/dbus \
                        -I$(srcdir)/../cmacs/gi -I$(srcdir)/../cmacs/crispy \
                        -I$(srcdir)/../cmacs/bacon -I$(srcdir)/../cmacs/gowl \
                        -I$(srcdir)/../cmacs/podomation \
                        -I$(srcdir)/../cmacs/libreclaw \
                        -I$(srcdir)/../cmacs/org-ex \
                        -I$(srcdir)/../cmacs/mcp \
                        -I$(srcdir)/../cmacs/cintrospect \
                        -I$(srcdir)/../cmacs/cpatch \
                        -I$(srcdir)/../cmacs/video \
                        -I$(srcdir)/../cmacs/audio \
                        -I$(srcdir)/../cmacs/whisper \
                        -I$(srcdir)/../cmacs/piper \
                        -I$(srcdir)/../cmacs/ai \
                        -I$(srcdir)/../cmacs/libregnum \
                        -I$(srcdir)/../cmacs/gnuseye \
                        -I$(srcdir)/../cmacs/graphcore \
                        -I$(srcdir)/../cmacs/roamgraph \
                        -I$(srcdir)/../cmacs/secondbrain \
                        -I$(srcdir)/../cmacs/office \
                        -I$(srcdir)/../cmacs/dbexplorer \
                        -I$(srcdir)/../cmacs/lrgscript \
                        -I$(srcdir)/../cmacs/cad \
                        -I$(srcdir)/../cmacs/screensaver \
                        -I$(srcdir)/../cmacs/gsurf \
                        -I$(srcdir)/../cmacs/lrgterm \
                        -I$(srcdir)/../cmacs/imgedit \
                        -I$(srcdir)/../cmacs/vidstudio \
                        -I$(srcdir)/../cmacs/calculator \
                        -I$(srcdir)/../cmacs/lsp \
                        -I$(srcdir)/../cmacs/ai-brigade \
                        -I$(srcdir)/../cmacs/api \
                        -DCMACS_SRCDIR=\"$(abspath $(srcdir))\"
CMACS_CFLAGS = $(CMACS_INTERNAL_CFLAGS) \
               $(CMACS_GLIB_CFLAGS) $(CMACS_GI_CFLAGS) \
               $(CMACS_CRISPY_CFLAGS) $(CMACS_BACON_CFLAGS) \
               $(CMACS_GOWL_CFLAGS) $(CMACS_PODOMATION_CFLAGS) \
               $(CMACS_LIBRECLAW_CFLAGS) \
               $(CMACS_ORG_EX_CFLAGS) \
               $(CMACS_MCP_CFLAGS) \
               $(CMACS_CINTROSPECT_CFLAGS) \
               $(CMACS_VIDEO_CFLAGS) \
               $(CMACS_AUDIO_CFLAGS) \
               $(CMACS_WHISPER_CFLAGS) \
               $(CMACS_PIPER_CFLAGS) \
               $(CMACS_AI_CFLAGS) \
               $(CMACS_LIBREGNUM_CFLAGS) \
               $(CMACS_GNUSEYE_CFLAGS) \
               $(CMACS_ROAMGRAPH_CFLAGS) \
               $(CMACS_SECONDBRAIN_CFLAGS) \
               $(CMACS_OFFICE_CFLAGS) \
               $(CMACS_LRGSCRIPT_CFLAGS) \
               $(CMACS_CAD_CFLAGS) \
               $(CMACS_SCREENSAVER_CFLAGS) \
               $(CMACS_GSURF_CFLAGS) \
               $(CMACS_LRGTERM_CFLAGS) \
               $(CMACS_IMGEDIT_CFLAGS) \
               $(CMACS_VIDSTUDIO_CFLAGS) \
               $(CMACS_LSP_CFLAGS) \
               $(CMACS_DBEXPLORER_CFLAGS) \
               $(CMACS_AI_BRIGADE_CFLAGS)

## emacs.res if HAVE_W32
EMACSRES = @EMACSRES@
## If HAVE_W32, compiler arguments for including
## the resource file in the binary.
## Cygwin: -Wl,emacs.res
## MinGW: emacs.res
W32_RES_LINK=@W32_RES_LINK@

## Empty if !HAVE_X_WINDOWS
## xfont.o ftfont.o xftfont.o if HAVE_XFT
## xfont.o ftfont.o if HAVE_FREETYPE
## xfont.o ftfont.o ftcrfont.o if USE_CAIRO
## else xfont.o
## if HAVE_HARFBUZZ, hbfont.o is added regardless of the rest
FONT_OBJ=@FONT_OBJ@

## Empty for MinGW and Android, cm.o for the rest.
CM_OBJ=@CM_OBJ@

LIBGPM = @LIBGPM@

LIBSELINUX_LIBS = @LIBSELINUX_LIBS@
LIBSELINUX_CFLAGS = @LIBSELINUX_CFLAGS@

LIBGNUTLS_LIBS = @LIBGNUTLS_LIBS@
LIBGNUTLS_CFLAGS = @LIBGNUTLS_CFLAGS@

LIBSYSTEMD_LIBS = @LIBSYSTEMD_LIBS@
LIBSYSTEMD_CFLAGS = @LIBSYSTEMD_CFLAGS@

TREE_SITTER_LIBS = @TREE_SITTER_LIBS@
TREE_SITTER_CFLAGS = @TREE_SITTER_CFLAGS@

INTERVALS_H = dispextern.h intervals.h composite.h

GETLOADAVG_LIBS = @GETLOADAVG_LIBS@

LIBGMP = @LIBGMP@

LIBGCCJIT_LIBS = @LIBGCCJIT_LIBS@
LIBGCCJIT_CFLAGS = @LIBGCCJIT_CFLAGS@

## dynlib.o if necessary, else empty
DYNLIB_OBJ = @DYNLIB_OBJ@

RUN_TEMACS = ./temacs

# Whether builds should contain details. '--no-build-details' or empty.
BUILD_DETAILS = @BUILD_DETAILS@

HAIKU_OBJ = @HAIKU_OBJ@
HAIKU_CXX_OBJ = @HAIKU_CXX_OBJ@
HAIKU_LIBS = @HAIKU_LIBS@
HAIKU_CFLAGS = @HAIKU_CFLAGS@

ANDROID_OBJ = @ANDROID_OBJ@
ANDROID_LIBS = @ANDROID_LIBS@
ANDROID_LDFLAGS = @ANDROID_LDFLAGS@
ANDROID_BUILD_CFLAGS = @ANDROID_BUILD_CFLAGS@

LIBGMP_CFLAGS = @LIBGMP_CFLAGS@

DUMPING=@DUMPING@
CHECK_STRUCTS = @CHECK_STRUCTS@
HAVE_PDUMPER = @HAVE_PDUMPER@

HAVE_BE_APP = @HAVE_BE_APP@

## ARM Macs require that all code have a valid signature.  Since pdump
## invalidates the signature, we must re-sign to fix it.
DO_CODESIGN=$(patsubst aarch64-apple-darwin%,yes,@configuration@)

-include ${top_builddir}/src/verbose.mk

bootstrap_exe = ../src/bootstrap-emacs$(EXEEXT)
ifeq ($(DUMPING),pdumper)
bootstrap_pdmp := bootstrap-emacs.pdmp # Keep in sync with loadup.el
pdmp := emacs.pdmp
else
bootstrap_pdmp :=
pdmp :=
endif

# Flags that might be in WARN_CFLAGS but are not valid for Objective C.
NON_OBJC_CFLAGS = -Wignored-attributes -Wignored-qualifiers -Wopenmp-simd \
  -Wnested-externs -Wstrict-flex-arrays -Wflex-array-member-not-at-end
# Ditto, but for C++.
NON_CXX_CFLAGS = -Wmissing-prototypes -Wnested-externs -Wold-style-definition \
  -Wstrict-prototypes -Wno-override-init

# -Demacs makes some files produce the correct version for use in Emacs.
# MYCPPFLAGS is for by-hand Emacs-specific overrides, e.g.,
# "make MYCPPFLAGS='-DDBUS_DEBUG'".
EMACS_CFLAGS=-Demacs $(MYCPPFLAGS) -I. -I$(srcdir) \
  -I$(lib) -I$(top_srcdir)/lib \
  $(C_SWITCH_MACHINE) $(C_SWITCH_SYSTEM) $(C_SWITCH_X_SITE) \
  $(GNUSTEP_CFLAGS) $(CFLAGS_SOUND) $(RSVG_CFLAGS) $(IMAGEMAGICK_CFLAGS) \
  $(PNG_CFLAGS) $(LIBXML2_CFLAGS) $(LIBGCCJIT_CFLAGS) $(DBUS_CFLAGS) \
  $(XRANDR_CFLAGS) $(XINERAMA_CFLAGS) $(XFIXES_CFLAGS) $(XDBE_CFLAGS) \
  $(XINPUT_CFLAGS) $(WEBP_CFLAGS) $(WEBKIT_CFLAGS) $(LCMS2_CFLAGS) \
  $(SETTINGS_CFLAGS) $(FREETYPE_CFLAGS) $(FONTCONFIG_CFLAGS) \
  $(HARFBUZZ_CFLAGS) $(LIBOTF_CFLAGS) $(M17N_FLT_CFLAGS) $(DEPFLAGS) \
  $(LIBSYSTEMD_CFLAGS) $(XSYNC_CFLAGS) $(TREE_SITTER_CFLAGS) \
  $(LIBGNUTLS_CFLAGS) $(NOTIFY_CFLAGS) $(CAIRO_CFLAGS) \
  $(WERROR_CFLAGS) $(HAIKU_CFLAGS) $(XCOMPOSITE_CFLAGS) $(XSHAPE_CFLAGS) \
  $(ANDROID_BUILD_CFLAGS) $(GIF_CFLAGS) $(JPEG_CFLAGS) $(SQLITE3_CFLAGS) \
  $(LIBGMP_CFLAGS) $(TIFF_CFLAGS) $(LIBSELINUX_CFLAGS) $(CMACS_CFLAGS)
ALL_CFLAGS = $(EMACS_CFLAGS) $(WARN_CFLAGS) $(CFLAGS)
ALL_OBJC_CFLAGS = $(EMACS_CFLAGS) \
  $(filter-out $(NON_OBJC_CFLAGS),$(WARN_CFLAGS)) $(CFLAGS) \
  $(GNU_OBJC_CFLAGS)
ALL_CXX_CFLAGS = $(EMACS_CFLAGS) \
  $(filter-out $(NON_CXX_CFLAGS),$(WARN_CFLAGS)) $(CXXFLAGS)

.SUFFIXES: .c .m .cc
.c.o:
	$(AM_V_CC)$(CC) -c $(CPPFLAGS) $(ALL_CFLAGS) $(PROFILING_CFLAGS) $<
.m.o:
	$(AM_V_CC)$(CC) -c $(CPPFLAGS) $(ALL_OBJC_CFLAGS) $(PROFILING_CFLAGS) $<
.cc.o:
	$(AM_V_CXX)$(CXX) -c $(CPPFLAGS) $(ALL_CXX_CFLAGS) $(PROFILING_CFLAGS) $<

base_obj = dispnew.o frame.o scroll.o xdisp.o menu.o $(XMENU_OBJ) window.o     \
	charset.o coding.o category.o ccl.o character.o chartab.o bidi.o       \
	$(CM_OBJ) term.o terminal.o xfaces.o $(XOBJ) $(GTK_OBJ) $(DBUS_OBJ)    \
	emacs.o keyboard.o macros.o keymap.o sysdep.o 			       \
	bignum.o buffer.o filelock.o insdel.o marker.o 			       \
	minibuf.o fileio.o dired.o 					       \
	cmds.o casetab.o casefiddle.o indent.o search.o regex-emacs.o undo.o   \
	alloc.o pdumper.o data.o doc.o editfns.o callint.o 		       \
	eval.o floatfns.o fns.o sort.o font.o print.o lread.o $(MODULES_OBJ)   \
	syntax.o bytecode.o comp.o $(DYNLIB_OBJ)			       \
	process.o gnutls.o callproc.o					       \
	region-cache.o sound.o timefns.o atimer.o			       \
	doprnt.o intervals.o textprop.o composite.o xml.o lcms.o $(NOTIFY_OBJ) \
	$(XWIDGETS_OBJ) 						       \
	profiler.o decompress.o 					       \
	thread.o systhread.o sqlite.o  treesit.o			       \
	itree.o json.o 							       \
	$(MSDOS_OBJ) $(MSDOS_X_OBJ) $(NS_OBJ) $(CYGWIN_OBJ) $(FONT_OBJ)        \
	$(W32_OBJ) $(WINDOW_SYSTEM_OBJ) $(XGSELOBJ)			       \
	$(HAIKU_OBJ) $(PGTK_OBJ) $(ANDROID_OBJ) \
	$(CMACS_CORE_OBJ) $(CMACS_GLIB_OBJ) $(CMACS_GI_OBJ) $(CMACS_CRISPY_OBJ) $(CMACS_BACON_OBJ) $(CMACS_GOWL_OBJ) $(CMACS_PODOMATION_OBJ) $(CMACS_LIBRECLAW_OBJ) $(CMACS_ORG_EX_OBJ) $(CMACS_MCP_OBJ) $(CMACS_CINTROSPECT_OBJ) $(CMACS_CPATCH_OBJ) $(CMACS_VIDEO_OBJ) $(CMACS_AUDIO_OBJ) $(CMACS_WHISPER_OBJ) $(CMACS_PIPER_OBJ) $(CMACS_AI_OBJ) $(CMACS_LIBREGNUM_OBJ) $(CMACS_GNUSEYE_OBJ) $(CMACS_GRAPHCORE_OBJ) $(CMACS_ROAMGRAPH_OBJ) $(CMACS_SECONDBRAIN_OBJ) $(CMACS_LRGSCRIPT_OBJ) $(CMACS_CAD_OBJ) $(CMACS_SCREENSAVER_OBJ) $(CMACS_GSURF_OBJ) $(CMACS_LRGTERM_OBJ) $(CMACS_IMGEDIT_OBJ) $(CMACS_VIDSTUDIO_OBJ) $(CMACS_CALCULATOR_OBJ) $(CMACS_LSP_OBJ) $(CMACS_OFFICE_OBJ) $(CMACS_DBEXPLORER_OBJ) $(CMACS_AI_BRIGADE_OBJ)
doc_obj = $(base_obj) $(NS_OBJC_OBJ)
obj = $(doc_obj) $(HAIKU_CXX_OBJ)

## Object files used on some machine or other.
## These go in the DOC file on all machines in case they are needed.
## Some of them have no DOC entries, but it does no harm to have them
## in the list, in case they ever add any such entries.
SOME_MACHINE_OBJECTS = dosfns.o msdos.o \
  xterm.o xfns.o xmenu.o xselect.o xrdb.o xsmfns.o fringe.o image.o \
  fontset.o dbusbind.o cygw32.o \
  nsterm.o nsfns.o nsmenu.o nsselect.o nsimage.o nsfont.o macfont.o \
  nsxwidget.o \
  w32.o w32console.o w32cygwinx.o w32fns.o w32heap.o w32inevt.o w32notify.o \
  w32menu.o w32proc.o w32reg.o w32select.o w32term.o w32xfns.o \
  w16select.o widget.o xfont.o ftfont.o xftfont.o gtkutil.o \
  xsettings.o xgselect.o termcap.o hbfont.o \
  haikuterm.o haikufns.o haikumenu.o haikufont.o androidterm.o androidfns.o \
  androidfont.o androidselect.c androidvfs.c sfntfont-android.c sfntfont.c

## gmalloc.o if !SYSTEM_MALLOC && !DOUG_LEA_MALLOC, else empty.
GMALLOC_OBJ=@GMALLOC_OBJ@

## vm-limit.o if !SYSTEM_MALLOC, else empty.
VMLIMIT_OBJ=@VMLIMIT_OBJ@

## ralloc.o if !SYSTEM_MALLOC && REL_ALLOC, else empty.
RALLOC_OBJ=@RALLOC_OBJ@

## List of object files that make-docfile should not be told about.
otherobj= $(TERMCAP_OBJ) $(GMALLOC_OBJ) $(RALLOC_OBJ) $(WIDGET_OBJ) $(LIBOBJS)

## All object files linked into temacs.  $(VMLIMIT_OBJ) should be first.
ALLOBJS = $(VMLIMIT_OBJ) $(obj) $(otherobj)

# Must be first, before dep inclusion!
ifneq ($(HAVE_BE_APP),yes)
all: emacs$(EXEEXT) $(pdmp) $(OTHER_FILES)
else
all: Emacs Emacs.pdmp $(OTHER_FILES)
endif
ifeq ($(HAVE_NATIVE_COMP):$(NATIVE_DISABLED),yes:)
all: ../native-lisp
endif
ifeq ($(CMACS_GOWL_BUNDLED),yes)
all: $(GOWL_WALLPAPER_SO)
endif
ifeq ($(CMACS_BACON_BUNDLED),yes)
all: cmacs-bacon-dep-modules
endif
ifneq ($(CMACS_BACON_OBJ),)
all: $(CMACS_BACON_MODULES)
endif
ifeq ($(CMACS_PODOMATION_BUNDLED),yes)
all: cmacs-podomation-modules
endif
ifneq ($(CMACS_GSURF_OBJ),)
all: cmacs-gsurf-modules
endif
.PHONY: all

dmpstruct_headers=$(srcdir)/lisp.h $(srcdir)/buffer.h $(srcdir)/itree.h \
	$(srcdir)/intervals.h $(srcdir)/charset.h $(srcdir)/bignum.h
ifeq ($(CHECK_STRUCTS),true)
pdumper.o: dmpstruct.h
endif
dmpstruct.h: $(srcdir)/dmpstruct.awk
dmpstruct.h: $(libsrc)/make-fingerprint$(EXEEXT) $(dmpstruct_headers)
	$(AM_V_GEN)POSIXLY_CORRECT=1 $(AWK) -f $(srcdir)/dmpstruct.awk \
		$(dmpstruct_headers) > $@

AUTO_DEPEND = @AUTO_DEPEND@
DEPDIR = deps
ifeq ($(AUTO_DEPEND),yes)
  DEPFLAGS = -MMD -MF $(DEPDIR)/$*.d -MP
  -include $(ALLOBJS:%.o=$(DEPDIR)/%.d)
else
  DEPFLAGS =
  include $(srcdir)/deps.mk
endif

## This is the list of all Lisp files that might be loaded into the
## dumped Emacs.  Some of them are not loaded on all platforms, but
## the DOC file on every platform uses them (because the DOC file is
## supposed to be platform-independent).
## Note that this list should not include lisp files which might not
## be present, like site-load.el and site-init.el; this makefile
## expects them all to be either present or buildable.
##
## To generate this list from loadup.el, we can either:
## 1) Extract everything matching (load "..."), in which case
## we need to add charprop.el by hand; or
## 2) Extract everything matching (load "...", in which case
## we need to remove leim-list, site-init, and site-load by hand.
## There's not much to choose between these two approaches,
## but the second one seems like it could be more future-proof.
##
## This list is placed in the toplevel build directory to prevent it
## from being unnecessarily regenerated by the successive use of this
## Makefile within cross/Makefile.
shortlisp =
$(abs_top_builddir)/src/lisp.mk: $(lispsource)/loadup.el
	${AM_V_GEN}( printf 'shortlisp = \\\n'; \
	sed -n 's/^[ \t]*(load "\([^"]*\)".*/\1/p' $< | \
	  sed -e 's/$$/.elc \\/' -e 's/\.el\.elc/.el/'; \
	echo "" ) > $@.tmp
	$(AM_V_at)mv -f $@.tmp $@

-include $(abs_top_builddir)/src/lisp.mk
shortlisp_filter = leim/leim-list.el site-load.elc site-init.elc
shortlisp := $(filter-out ${shortlisp_filter},${shortlisp})
## Place loaddefs.el first, so it gets generated first, since it is on
## the critical path (relevant in parallel compilations).
## We don't really need to sort, but may as well use it to remove duplicates.
shortlisp := loaddefs.el loadup.el $(sort ${shortlisp})
export LISP_PRELOADED = ${shortlisp}
lisp = $(addprefix ${lispsource}/,${shortlisp})

## Construct full set of libraries to be linked.
LIBES = $(LIBS) $(W32_LIBS) $(LIBS_GNUSTEP) $(PGTK_LIBS) $(LIBX_BASE) $(LIBIMAGE) \
   $(LIBX_OTHER) $(LIBSOUND) \
   $(RSVG_LIBS) $(IMAGEMAGICK_LIBS) $(LIB_ACL) $(CLOCK_TIME_LIB) \
   $(NANOSLEEP_LIB) $(QCOPY_ACL_LIB) $(WEBKIT_LIBS) \
   $(EUIDACCESS_LIBGEN) $(TIMER_TIME_LIB) $(DBUS_LIBS) \
   $(LIB_EXECINFO) $(XRANDR_LIBS) $(XINERAMA_LIBS) $(XFIXES_LIBS) \
   $(XDBE_LIBS) $(XSYNC_LIBS) \
   $(LIBXML2_LIBS) $(LIBGPM) $(LIBS_SYSTEM) $(CAIRO_LIBS) \
   $(LIBS_TERMCAP) $(GETLOADAVG_LIBS) $(SETTINGS_LIBS) $(LIBSELINUX_LIBS) \
   $(FREETYPE_LIBS) $(FONTCONFIG_LIBS) $(HARFBUZZ_LIBS) $(LIBOTF_LIBS) $(M17N_FLT_LIBS) \
   $(LIBGNUTLS_LIBS) $(LIB_PTHREAD) $(GETADDRINFO_A_LIBS) $(LCMS2_LIBS) \
   $(NOTIFY_LIBS) $(LIB_MATH) $(LIBZ) $(LIBMODULES) $(LIBSYSTEMD_LIBS) \
   $(LIBGMP) $(LIBGCCJIT_LIBS) $(XINPUT_LIBS) $(HAIKU_LIBS) \
   $(TREE_SITTER_LIBS) $(SQLITE3_LIBS) $(XCOMPOSITE_LIBS) $(XSHAPE_LIBS) \
   $(ANDROID_LIBS) \
   $(CMACS_GLIB_LIBS) $(CMACS_GI_LIBS) $(CMACS_CRISPY_LIBS) \
   $(CMACS_BACON_LIBS) $(CMACS_GOWL_LIBS) $(CMACS_PODOMATION_LIBS) \
   $(CMACS_LIBRECLAW_LIBS) $(CMACS_ORG_EX_LIBS) $(CMACS_MCP_LIBS) \
   $(CMACS_CINTROSPECT_LIBS) $(CMACS_CPATCH_LIBS) \
   $(CMACS_VIDEO_LIBS) $(CMACS_AUDIO_LIBS) \
   $(CMACS_WHISPER_LIBS) $(CMACS_PIPER_LIBS) $(CMACS_AI_LIBS) $(CMACS_LIBREGNUM_LIBS) \
   $(CMACS_GNUSEYE_LIBS) $(CMACS_ROAMGRAPH_LIBS) $(CMACS_SECONDBRAIN_LIBS) $(CMACS_LRGSCRIPT_LIBS) $(CMACS_CAD_LIBS) $(CMACS_SCREENSAVER_LIBS) $(CMACS_GSURF_LIBS) $(CMACS_LRGTERM_LIBS) $(CMACS_IMGEDIT_LIBS) $(CMACS_VIDSTUDIO_LIBS) $(CMACS_LSP_LIBS) $(CMACS_OFFICE_LIBS) $(CMACS_DBEXPLORER_LIBS) $(CMACS_AI_BRIGADE_LIBS)

## FORCE it so that admin/unidata can decide whether this file is
## up-to-date.  Although since charprop depends on bootstrap-emacs,
## and emacs depends on charprop, in practice this rule was always run
## anyway.
ifneq ($(XCONFIGURE),android)
$(lispsource)/international/charprop.el: \
  FORCE | bootstrap-emacs$(EXEEXT) $(bootstrap_pdmp)
	$(MAKE) -C ../admin/unidata all EMACS="../$(bootstrap_exe)"
endif

## We require charprop.el to exist before ucs-normalize.el is
## byte-compiled, because ucs-normalize.el needs to load 2 uni-*.el files.
## And ns-win requires ucs-normalize.
$(lispsource)/international/ucs-normalize.elc $(lispsource)/term/ns-win.elc: | \
  $(lispsource)/international/charprop.el

lispintdir = ${lispsource}/international
${lispintdir}/cp51932.el ${lispintdir}/eucjp-ms.el: FORCE
	${MAKE} -C ../admin/charsets $(notdir $@)

charsets = ${top_srcdir}/admin/charsets/charsets.stamp
${charsets}: FORCE
	$(MAKE) -C ../admin/charsets all

charscript = ${lispintdir}/charscript.el
${charscript}: FORCE
	$(MAKE) -C ../admin/unidata $(notdir $@)

emoji-zwj = ${lispintdir}/emoji-zwj.el
${emoji-zwj}: FORCE
	$(MAKE) -C ../admin/unidata $(notdir $@)

${lispintdir}/characters.elc: ${charscript:.el=.elc} ${emoji-zwj:.el=.elc}

SYSTEM_TYPE = @SYSTEM_TYPE@

## The dumped Emacs is as functional and more efficient than
## bootstrap-emacs, so we replace the latter with the former.
## Strictly speaking, emacs does not depend directly on all of $lisp,
## since not all pieces are used on all platforms.  But DOC depends
## on all of $lisp, and emacs depends on DOC, so it is ok to use $lisp here.
emacs$(EXEEXT): temacs$(EXEEXT) \
                $(abs_top_builddir)/src/lisp.mk $(etc)/DOC $(lisp) \
                $(lispsource)/international/charprop.el ${charsets}
ifeq ($(SYSTEM_TYPE),cygwin)
	find ${top_builddir} -name '*.eln' | rebase -v -O -T -
endif
	rm -f $@ && cp -f temacs$(EXEEXT) $@

## On Haiku, also produce a binary named Emacs with the appropriate
## icon set.

ifeq ($(HAVE_BE_APP),yes)
Emacs: emacs$(EXEEXT) $(libsrc)/be-resources
	$(AM_V_GEN) cp -f emacs$(EXEEXT) $@
	$(AM_V_at) $(libsrc)/be-resources \
	  $(etc)/images/icons/hicolor/32x32/apps/emacs.png $@
Emacs.pdmp: $(pdmp)
	$(AM_V_GEN) cp -f $(pdmp) $@
endif

ifeq ($(DUMPING),pdumper)
$(pdmp): emacs$(EXEEXT) $(lispsource)/loaddefs.el $(lispsource)/loaddefs.elc
	LC_ALL=C $(RUN_TEMACS) -batch $(BUILD_DETAILS) -l loadup --temacs=pdump \
		--bin-dest '$(BIN_DESTDIR)' --eln-dest '$(ELN_DESTDIR)'
	cp -f $@ $(bootstrap_pdmp)
endif

## $(SOME_MACHINE_OBJECTS) comes before $(obj) because some files may
## or may not be included in $(obj), but they are always included in
## $(SOME_MACHINE_OBJECTS).  Since a file is processed when it is mentioned
## for the first time, this prevents any variation between configurations
## in the contents of the DOC file.
##
$(etc)/DOC: $(libsrc)/make-docfile$(EXEEXT) $(doc_obj)
	$(AM_V_GEN)$(MKDIR_P) $(etc)
	$(AM_V_at)rm -f $(etc)/DOC
	$(AM_V_at)$(libsrc)/make-docfile -d $(srcdir) \
	  $(SOME_MACHINE_OBJECTS) $(doc_obj) > $(etc)/DOC

$(libsrc)/make-docfile$(EXEEXT) $(libsrc)/make-fingerprint$(EXEEXT): \
  $(hostlib)/libgnu.a
	$(MAKE) -C $(dir $@) $(notdir $@)

buildobj.h: Makefile
	$(AM_V_GEN)for i in $(ALLOBJS); do \
	  echo "$$i" | sed 's,.*/,,; s/\.obj$$/\.o/; s/^/"/; s/$$/",/' \
	    || exit; \
	done >$@.tmp
	$(AM_V_at)mv $@.tmp $@

GLOBAL_SOURCES = $(base_obj:.o=.c) $(NS_OBJC_OBJ:.o=.m)

## CMACS: make-docfile needs .c files visible from srcdir.
## Create symlinks so scanning finds the DEFUN docstrings.
CMACS_ALL_OBJ = $(CMACS_CORE_OBJ) $(CMACS_GLIB_OBJ) $(CMACS_GI_OBJ) \
                $(CMACS_CRISPY_OBJ) $(CMACS_BACON_OBJ) $(CMACS_GOWL_OBJ) \
                $(CMACS_PODOMATION_OBJ) $(CMACS_LIBRECLAW_OBJ) \
                $(CMACS_ORG_EX_OBJ) $(CMACS_MCP_OBJ) \
                $(CMACS_CINTROSPECT_OBJ) $(CMACS_CPATCH_OBJ) \
                $(CMACS_VIDEO_OBJ) $(CMACS_AUDIO_OBJ) \
                $(CMACS_WHISPER_OBJ) $(CMACS_PIPER_OBJ) \
                $(CMACS_AI_OBJ) $(CMACS_LIBREGNUM_OBJ) \
                $(CMACS_GNUSEYE_OBJ) $(CMACS_GRAPHCORE_OBJ) $(CMACS_ROAMGRAPH_OBJ) \
                $(CMACS_SECONDBRAIN_OBJ) \
                $(CMACS_OFFICE_OBJ) \
                $(CMACS_DBEXPLORER_OBJ) \
                $(CMACS_LRGSCRIPT_OBJ) $(CMACS_CAD_OBJ) \
                $(CMACS_SCREENSAVER_OBJ) $(CMACS_GSURF_OBJ) \
                $(CMACS_LRGTERM_OBJ) $(CMACS_IMGEDIT_OBJ) \
                $(CMACS_VIDSTUDIO_OBJ) $(CMACS_CALCULATOR_OBJ) \
                $(CMACS_LSP_OBJ) $(CMACS_AI_BRIGADE_OBJ)
CMACS_DIRS = core glib gobject dbus gi crispy bacon gowl podomation libreclaw org-ex mcp cintrospect cpatch video audio whisper piper ai ai-brigade libregnum gnuseye graphcore roamgraph secondbrain office lrgscript cad screensaver gsurf lrgterm imgedit vidstudio calculator lsp dbexplorer
cmacs-symlinks:
	$(AM_V_at)for f in $(CMACS_ALL_OBJ:.o=.c); do \
	  test -e "$(srcdir)/$$f" && continue; \
	  for d in $(CMACS_DIRS); do \
	    src="$(srcdir)/../cmacs/$$d/$$f"; \
	    if test -f "$$src"; then ln -sf "$$src" "$(srcdir)/$$f"; break; fi; \
	  done; \
	done
.PHONY: cmacs-symlinks

gl-stamp: $(libsrc)/make-docfile$(EXEEXT) $(GLOBAL_SOURCES) cmacs-symlinks
	$(AM_V_GLOBALS)$(libsrc)/make-docfile -d $(srcdir) -g $(doc_obj) > globals.tmp
	$(AM_V_at)$(top_srcdir)/build-aux/move-if-change globals.tmp globals.h
	$(AM_V_at)echo timestamp > $@

globals.h: gl-stamp; @true

$(ALLOBJS): globals.h

LIBEGNU_ARCHIVE = $(lib)/libgnu.a

$(LIBEGNU_ARCHIVE): $(config_h)
	$(MAKE) -C $(dir $@) all

ifeq ($(HAVE_PDUMPER),yes)
MAKE_PDUMPER_FINGERPRINT = $(libsrc)/make-fingerprint$(EXEEXT)
else
MAKE_PDUMPER_FINGERPRINT =
endif

## Build bundled static libraries if needed
ifeq ($(CMACS_BACON_BUNDLED),yes)
CMACS_BACON_STATIC_LIB = $(srcdir)/../deps/bacon/build/$(CMACS_DEP_BUILDTYPE)/libbacon-1.0.a
$(CMACS_BACON_STATIC_LIB):
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/bacon lib-static

## Build bacon module .so files (loaded at runtime, not linked into temacs).
.PHONY: cmacs-bacon-dep-modules
cmacs-bacon-dep-modules: $(CMACS_BACON_STATIC_LIB)
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/bacon modules
endif

ifeq ($(CMACS_CRISPY_BUNDLED),yes)
CMACS_CRISPY_STATIC_LIB = $(srcdir)/../deps/crispy/build/$(CMACS_DEP_BUILDTYPE)/libcrispy.a
$(CMACS_CRISPY_STATIC_LIB):
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/crispy lib
endif

ifeq ($(CMACS_GOWL_BUNDLED),yes)
CMACS_GOWL_STATIC_LIB = $(srcdir)/../deps/gowl/build/$(CMACS_DEP_BUILDTYPE)/libgowl.a
$(CMACS_GOWL_STATIC_LIB):
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/gowl lib

## Objects that include gowl.h (directly or via cmacs-eval-dispatch.h)
## need gowl-version.h, which is generated during the gowl lib build.
$(CMACS_GOWL_OBJ) $(CMACS_GLIB_OBJ) $(CMACS_BACON_OBJ): $(CMACS_GOWL_STATIC_LIB)

## Build gowl wallpaper module .so (loaded at runtime, not linked into temacs).
## gowl's own `make` builds this as part of its modules target.
GOWL_WALLPAPER_SO = $(srcdir)/../deps/gowl/build/$(CMACS_DEP_BUILDTYPE)/modules/wallpaper.so
$(GOWL_WALLPAPER_SO): $(CMACS_GOWL_STATIC_LIB)
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/gowl modules
endif

ifeq ($(CMACS_PODOMATION_BUNDLED),yes)
CMACS_PODOMATION_STATIC_LIB = $(srcdir)/../deps/podomation/build/$(CMACS_DEP_BUILDTYPE)/libpodomation-1.0.a

## Redirect podomation's ai-glib build at the canonical top-level
## deps/ai-glib so the AI module .so files share a single ai-glib
## copy with the rest of cmacs (same arrangement libreclaw uses).
## podomation's module sub-make loop hardcodes `$(CURDIR)/$(AI_GLIB_DIR)/...'
## so AI_GLIB_DIR has to be a relative path that resolves correctly
## from podomation/.  `../ai-glib' is relative to podomation/ which
## sits next to ai-glib/ under deps/.  Only fires when --with-cmacs-ai
## is on; otherwise let podomation build its own copy as before.
ifneq ($(CMACS_AI_OBJ),)
CMACS_PODOMATION_AI_GLIB_OVERRIDES = AI_GLIB_DIR=../ai-glib
$(CMACS_PODOMATION_STATIC_LIB): $(CMACS_AI_GLIB_STATIC_LIB)
else
CMACS_PODOMATION_AI_GLIB_OVERRIDES =
endif

$(CMACS_PODOMATION_STATIC_LIB):
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/podomation \
	  $(CMACS_PODOMATION_AI_GLIB_OVERRIDES) \
	  lib-static

## Objects that include podomation.h need pod-version.h from the lib build.
$(CMACS_PODOMATION_OBJ): $(CMACS_PODOMATION_STATIC_LIB)

## Build podomation module .so files (separate target, not required for temacs)
.PHONY: cmacs-podomation-modules
cmacs-podomation-modules: $(CMACS_PODOMATION_STATIC_LIB)
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/podomation \
	  $(CMACS_PODOMATION_AI_GLIB_OVERRIDES) \
	  modules
endif

## Build bundled whisper.cpp static libraries when system whisper.pc is
## absent.  Recent whisper.cpp is CMake-only; we configure with
## BUILD_SHARED_LIBS=OFF and the small subset of options that matter for
## linking into temacs (no tests, no examples, no OpenMP — OpenMP would
## introduce a libgomp dep cmacs doesn't currently link).  Requires a
## C++ compiler at build time (gcc-c++ on Fedora, g++ on Debian); the
## install-deps script pulls these in.
ifeq ($(CMACS_WHISPER_BUNDLED),yes)
CMACS_WHISPER_STATIC_LIB = $(srcdir)/../deps/whisper.cpp/build/src/libwhisper.a
## FORCE, for the same reason as ai-glib above, and this one was learned
## the hard way: the rule used to have NO prerequisites, so make checked
## only that libwhisper.a existed.  Bumping the submodule (v1.8.4 ->
## v1.9.3) therefore compiled cmacs against the new headers and linked a
## three-month-old archive, and the build exited 0 -- an ABI mismatch
## that surfaces as a non-deterministic crash rather than an error.
##
## Configure only when there is no cache to reuse; after that always
## `cmake --build', which is a fast no-op when nothing changed and
## re-runs cmake itself when CMakeLists.txt moved (cmake generates that
## check into its own build system).  So the archive tracks the source
## without paying for a reconfigure on every make.
$(CMACS_WHISPER_STATIC_LIB): FORCE
	cd $(srcdir)/../deps/whisper.cpp && \
	  { test -f build/CMakeCache.txt || \
	    cmake -B build -DBUILD_SHARED_LIBS=OFF -DGGML_OPENMP=OFF \
	      -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=OFF \
	      -DCMAKE_C_STANDARD=11 -DCMAKE_CXX_STANDARD=17 \
	      -DCMAKE_C_STANDARD_REQUIRED=ON \
	      -DCMAKE_CXX_STANDARD_REQUIRED=ON ; } && \
	  cmake --build build --config Release --parallel
# The -DCMAKE_C/CXX_STANDARD flags work around a CMake 4.x feature-
# detection table that doesn't yet know about GCC 16; setting the
# standards explicitly makes target_compile_features a no-op.
$(CMACS_WHISPER_OBJ): $(CMACS_WHISPER_STATIC_LIB)
endif

## ai-glib is the canonical AI-provider library shared by cmacs-ai
## and cmacs-libreclaw.  Both vendor the same git submodule, but we
## build it exactly once at deps/ai-glib/ (top-level) and redirect
## libreclaw's sub-make at this artifact via AI_GLIB_DIR= so a
## second copy is never built or linked.  GIR=1 produces
## AiGlib-1.0.typelib alongside the archive so cmacs-gi can find it.
## libai-glib-1.0.a contains only ai_* objects (its vendored
## yaml-glib is linked into the .so but NOT embedded in the .a),
## so there is no duplicate-symbol risk against libbacon-1.0.a's
## canonical yaml_* set and no dedup rule is needed below.
## FORCE so edits under deps/ai-glib/src are picked up: the sub-make
## decides incrementality and only touches the archive when objects
## actually changed (same pattern as the org-ex hook below).
CMACS_AI_GLIB_STATIC_LIB = $(srcdir)/../deps/ai-glib/build/$(CMACS_DEP_BUILDTYPE)/libai-glib-1.0.a
ifneq ($(CMACS_AI_OBJ)$(CMACS_LIBRECLAW_OBJ),)
$(CMACS_AI_GLIB_STATIC_LIB): FORCE
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/ai-glib GIR=1 all
endif

ifeq ($(CMACS_LIBRECLAW_BUNDLED),yes)
## Build liblc-1.0.a (+ GIR/typelib) from deps/libreclaw/ as a static
## library.  The full libreclaw target produces shared, static, the
## CLI binary, and (since 0.18.0) Lc-1.0.gir/typelib by default.
## We depend on the static lib but invoke the `all` target so the
## GIR files also get produced and can be referenced by cmacs-gi at
## runtime via GI_TYPELIB_PATH.  AI_GLIB_DIR is overridden so
## libreclaw's nested deps/ai-glib sub-make becomes a no-op and the
## canonical cmacs build is consumed instead.
CMACS_LIBRECLAW_STATIC_LIB = $(srcdir)/../deps/libreclaw/build/$(CMACS_DEP_BUILDTYPE)/liblc-1.0.a
$(CMACS_LIBRECLAW_STATIC_LIB): $(CMACS_AI_GLIB_STATIC_LIB)
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/libreclaw \
	  AI_GLIB_DIR=$(abs_top_srcdir)/deps/ai-glib \
	  static gir

$(CMACS_LIBRECLAW_OBJ): $(CMACS_LIBRECLAW_STATIC_LIB)
## cmacs-ai compiles against ai-glib's public headers and ai-version.h
## (the latter generated by the ai-glib build), so force the canonical
## ai-glib build before any cmacs/ai/*.o is compiled.
$(CMACS_AI_OBJ): $(CMACS_AI_GLIB_STATIC_LIB)
endif

## cmacs-ai-brigade compiles against the same ai-glib public headers and
## the generated ai-version.h, so it needs the same ordering.  Kept
## OUTSIDE the CMACS_LIBRECLAW_BUNDLED conditional above deliberately:
## brigade requires cmacs-ai but not libreclaw, so a
## --with-cmacs-ai-brigade --without-cmacs-libreclaw build must still get
## the dependency.  (The $(CMACS_AI_OBJ) rule above has the same gap; it
## is left alone here to keep this change additive.)
ifneq ($(CMACS_AI_BRIGADE_OBJ),)
$(CMACS_AI_BRIGADE_OBJ): $(CMACS_AI_GLIB_STATIC_LIB)
endif

## libregnum: build deps/libregnum's static + shared lib once.
##
##  - WARN_CFLAGS: -Werror is disabled because newer GCC versions
##    surface additional warnings that libregnum upstream hasn't
##    curated yet (we don't want a downstream compiler tightening
##    to break cmacs's build).
##  - BUILD_GIR: builds Libregnum-1.typelib so the editor types are usable
##    over GObject-Introspection (cmacs's own gi subsystem + the libregnum
##    gjs/PyGObject scripting backends can `import Libregnum`).  Enabled
##    (BUILD_GIR=1) only when g-ir-scanner is present -- the scanner dlopens
##    liblibregnum.so to introspect types, which can fail in sandboxed/cross
##    (container) builds, so without the tool we fall back to BUILD_GIR=0
##    (typelib skipped; libregnum still links fine as a C library).  The
##    runtime path to the typelib is exported by the Justfile `run' recipe
##    (GI_TYPELIB_PATH); symbols resolve from temacs's own exported statics.
##  - We still invoke the default `all' target (not `lib'): `lib'
##    only depends on `generate', skipping `deps' which is what
##    runs graylib's sub-make.  Without `deps' running first,
##    graylib's grl-version.h never gets generated and libregnum's
##    own sources fail at #include "grl-version.h".  Passing
##    BUILD_GIR=0 to the default `all' target skips just the gir
##    sub-target while keeping the full check-deps -> platform-check
##    -> deps -> generate -> _lib pipeline.
## cad-glib: the canonical CAD kernel build (Manifold/OCCT/slvs +
## frontends).  FORCE so source edits under deps/cad-glib are picked
## up; the sub-make decides incrementality (ai-glib pattern).  The
## vendored manifold/solvespace archives build automatically as
## prerequisites inside cad-glib's own Makefile.
CMACS_CAD_GLIB_STATIC_LIB = $(srcdir)/../deps/cad-glib/build/$(CMACS_DEP_BUILDTYPE)/libcad-glib-1.0.a
ifneq ($(CMACS_CAD_OBJ),)
$(CMACS_CAD_GLIB_STATIC_LIB): FORCE
	@gir=1; \
	if ! command -v g-ir-scanner >/dev/null 2>&1; then gir=0; fi; \
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/cad-glib GIR=$$gir all

$(CMACS_CAD_OBJ): $(CMACS_CAD_GLIB_STATIC_LIB) $(CMACS_LIBREGNUM_STATIC_LIB)
endif

CMACS_LIBREGNUM_STATIC_LIB = $(srcdir)/../deps/libregnum/build/$(CMACS_DEP_BUILDTYPE)/lib/liblibregnum.a
ifneq ($(CMACS_LIBREGNUM_OBJ),)
##  - Scripting backends: Lua (luajit) and Python (python3-embed) auto-enable
##    from libregnum's own pkg-config probes when their -devel packages are
##    installed.  Gjs (and Python's pygobject bridge) need the GObject-
##    Introspection scripting base (HAS_GI), so we pass HAS_GI=1 +
##    GI_RUNTIME_{CFLAGS,LIBS} explicitly -- libregnum otherwise gates HAS_GI
##    behind BUILD_GIR, and we may build with BUILD_GIR=0 (above) when the
##    g-ir-scanner tool is absent.  All of these are no-ops when the respective
##    -devel packages / gobject-introspection-1.0 are absent, so the build
##    still works without them (only crispy then).
##  - FORCE so source edits under deps/libregnum (and its bundled graylib)
##    are picked up; the sub-make decides incrementality (ai-glib pattern).
##    Without it the rule never re-ran once liblibregnum.a existed, leaving
##    stale archives that fail the temacs link with undefined references.
$(CMACS_LIBREGNUM_STATIC_LIB): FORCE $(if $(CMACS_CAD_OBJ),$(CMACS_CAD_GLIB_STATIC_LIB))
	@gir=0; \
	if command -v g-ir-scanner >/dev/null 2>&1 \
	   && pkg-config --exists gobject-introspection-1.0; then gir=1; fi; \
	if pkg-config --exists girepository-2.0; then \
	  $(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/libregnum \
	    WARN_CFLAGS="-Wall -Wextra -Wno-unused-but-set-variable" \
	    BUILD_GIR=$$gir CRISPY=1 HAS_GI=1 $(CMACS_CAD_LIBREGNUM_FLAGS) \
	    GI_RUNTIME_CFLAGS="$$(pkg-config --cflags girepository-2.0)" \
	    GI_RUNTIME_LIBS="$$(pkg-config --libs girepository-2.0)"; \
	else \
	  $(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/libregnum \
	    WARN_CFLAGS="-Wall -Wextra -Wno-unused-but-set-variable" \
	    BUILD_GIR=0 CRISPY=1 $(CMACS_CAD_LIBREGNUM_FLAGS); \
	fi
$(CMACS_LIBREGNUM_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## gnuseye's render half (cmacs-gnuseye-globe.o) includes <libregnum.h>,
## which needs graylib's generated headers (grl-version.h) present.  Gate
## the gnuseye objects on the libregnum archive build so those headers
## exist before gnuseye compiles.
ifneq ($(CMACS_GNUSEYE_OBJ),)
$(CMACS_GNUSEYE_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## roamgraph's scene half (cmacs-roamgraph-scene.o) includes <libregnum.h>
## for the same reason, so order it behind the libregnum archive too.
ifneq ($(CMACS_ROAMGRAPH_OBJ),)
$(CMACS_ROAMGRAPH_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## secondbrain's scene half (cmacs-secondbrain-scene.o) includes
## <libregnum.h> for the same reason, so order it behind the libregnum
## archive too.
ifneq ($(CMACS_SECONDBRAIN_OBJ),)
$(CMACS_SECONDBRAIN_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## lrgscript's object half (cmacs-lrgscript-elisp.o) includes <libregnum.h>,
## which needs libregnum's/graylib's generated headers.  Gate the lrgscript
## objects on the libregnum archive build so those headers exist first.
ifneq ($(CMACS_LRGSCRIPT_OBJ),)
$(CMACS_LRGSCRIPT_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## CMACS: build the deps/screensavers libregnum game-module .so files
## (blackhole/singularity/helios), loaded at runtime via dlopen (NOT linked
## into temacs -- the screensaver subsystem resolves them by path).  The
## modules resolve lrg_*/grl_* from the host at load time, so we pin the build
## at cmacs's CANONICAL deps/libregnum via the LIBREGNUM_DIR override (which
## also redirects GRAYLIB_DIR/YAMLGLIB_DIR) instead of building deps/
## screensavers' own bundled copy: one libregnum, guaranteed-matching ABI, and
## no second engine build.  The dependency on the canonical archive guarantees
## libregnum's generated version headers (lrg-/grl-version.h) -- which the
## modules compile against -- already exist, also avoiding the -j race that
## made the old `make deps' step necessary.
ifneq ($(CMACS_SCREENSAVER_OBJ),)
SCREENSAVER_MODULES_SO = $(srcdir)/../deps/screensavers/build/$(CMACS_DEP_BUILDTYPE)/blackhole.so
$(SCREENSAVER_MODULES_SO): $(CMACS_LIBREGNUM_STATIC_LIB)
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/screensavers modules \
	    LIBREGNUM_DIR=$(abspath $(srcdir)/../deps/libregnum)
$(CMACS_SCREENSAVER_OBJ): | $(SCREENSAVER_MODULES_SO)
endif

## CMACS: output_lrg reuses the libregnum archive + its Lrg* term types, so
## build that archive (which carries graylib's generated headers) before
## compiling the lrgterm glue.
ifneq ($(CMACS_LRGTERM_OBJ),)
$(CMACS_LRGTERM_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## imgedit: cmacs-imgedit-doc.c consumes <libregnum.h> + the LrgImageDocument
## types in the canonical liblibregnum.a, so build that archive first.
ifneq ($(CMACS_IMGEDIT_OBJ),)
$(CMACS_IMGEDIT_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## calculator: cmacs-calculator-chart.c consumes <libregnum.h> + the LrgChart
## types in the canonical liblibregnum.a, so build that archive first.  Only
## the chart TU needs it -- the rest of the calculator is libregnum-free, and
## a --without-cmacs-libregnum build has no chart object at all.
ifneq ($(CMACS_CALCULATOR_OBJ),)
$(CMACS_CALCULATOR_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## vidstudio: cmacs-vidstudio-proj.c consumes <libregnum.h> + the Reel system
## in the canonical liblibregnum.a, so build that archive first.
ifneq ($(CMACS_VIDSTUDIO_OBJ),)
$(CMACS_VIDSTUDIO_OBJ): $(CMACS_LIBREGNUM_STATIC_LIB)
endif

## gsurf: built STATIC=1 (libgsurf.a whole-archived into temacs),
## BUILD_GIR=1 (Gsurf-0.1.typelib for cmacsgi), GTK_BACKEND=gtk3
## (matches pgtk + xwidgets' webkit2gtk-4.1).  The default `all' target
## also builds the stock modules into deps/gsurf/build/$(CMACS_DEP_BUILDTYPE)/modules
## and generates gsurf-version.h (which gsurf.h needs), so make the
## gsurf objects depend on the archive.
CMACS_GSURF_STATIC_LIB = $(srcdir)/../deps/gsurf/build/$(CMACS_DEP_BUILDTYPE)/libgsurf.a
ifneq ($(CMACS_GSURF_OBJ),)
## When the LRG backend is on, gsurf compiles src/backend/lrg/** and its own
## libgsurf.so links graylib/raylib -- so the libregnum build (which produces
## those archives) must run first.  The canonical liblibregnum.a provides the
## graylib/raylib symbols at the temacs link; libgsurf.a does NOT embed them
## (they are link-only in gsurf), so no graylib dedup is needed here.
ifeq ($(CMACS_GSURF_LRG),yes)
$(CMACS_GSURF_STATIC_LIB): $(CMACS_LIBREGNUM_STATIC_LIB)
endif
## Pin gsurf's LRG backend to cmacs's canonical libregnum (LIBREGNUM_DIR
## override) rather than gsurf's own bundled deps/libregnum, so only ONE
## libregnum/graylib/raylib is linked into temacs (the static-lib dedup
## invariant).  gsurf builds standalone against its own copy by default.
$(CMACS_GSURF_STATIC_LIB):
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/gsurf STATIC=1 BUILD_GIR=1 GTK_BACKEND=gtk3 \
	  $(if $(filter yes,$(CMACS_GSURF_LRG)),LRG_BACKEND=1 \
	    LIBREGNUM_DIR=$(abspath $(srcdir)/../deps/libregnum))
$(CMACS_GSURF_OBJ): $(CMACS_GSURF_STATIC_LIB)

## Build the cmacs-specific gsurf modules (.so loaded at runtime by the
## embedded module manager, NOT linked into temacs).  Depends on the
## gsurf lib build so the dev <gsurf/gsurf.h> symlink + gsurf-version.h
## exist.  Modules resolve gsurf_*/yaml_*/cmacs_gsurf_emacs_eval_async
## from the emacs executable (temacs --export-dynamic).
.PHONY: cmacs-gsurf-modules
cmacs-gsurf-modules: $(CMACS_GSURF_STATIC_LIB)
	$(MAKE) -C $(srcdir)/../cmacs/gsurf/modules \
	  GSURF_DIR=$(abspath $(srcdir)/../deps/gsurf)
endif

## Build libcmacs-api.so (used at runtime by crispy and bacon).
## Must be built before temacs so it's available for make install.
CMACS_API_SO = $(srcdir)/../cmacs/api/libcmacs-api.so
$(CMACS_API_SO):
	$(MAKE) -C $(srcdir)/../cmacs/api all

## Ensure the API .so is built when crispy or bacon objects are compiled.
ifneq ($(CMACS_CRISPY_OBJ),)
$(CMACS_CRISPY_OBJ): $(CMACS_API_SO)
endif
ifneq ($(CMACS_BACON_OBJ),)
$(CMACS_BACON_OBJ): $(CMACS_API_SO)

## Build cmacs bacon modules (cmacs_gi.so, cmacs_pod.so).
## These are runtime .so files loaded by bacon, not linked into temacs.
CMACS_BACON_MODULES = $(srcdir)/../cmacs/bacon/modules/cmacs_gi.so \
	$(srcdir)/../cmacs/bacon/modules/cmacs_pod.so
$(CMACS_BACON_MODULES): $(CMACS_API_SO)
	$(MAKE) -C $(srcdir)/../cmacs/bacon/modules \
		BACON_DIR=$(abspath $(srcdir)/../deps/bacon) \
		API_DIR=$(abspath $(srcdir)/../cmacs/api)
endif

## Build liborgex-1.0.a (statically linked into emacs).
##
## The recipe must run every top-level make to give the inner Makefile
## a chance to detect newer .c sources and rebuild --- the .a alone has
## no source prerequisites here.  Without this, a stale .a from `COPY .`
## in Containerfile (or any tree where the .a is older than the
## sources) survives into the temacs link and produces "undefined
## reference to org_ex_ink_*" errors at the linker.  The inner Makefile
## does its own up-to-date check, so this is cheap on no-op runs.
ifneq ($(CMACS_ORG_EX_OBJ),)
CMACS_ORG_EX_STATIC_LIB = $(srcdir)/../cmacs/org-ex/lib/liborgex-1.0.a
$(CMACS_ORG_EX_STATIC_LIB): FORCE
	$(MAKE) -C $(srcdir)/../cmacs/org-ex/lib static

$(CMACS_ORG_EX_OBJ): $(CMACS_ORG_EX_STATIC_LIB)
endif

# Empty-recipe sentinel; lets dependent rules always re-evaluate.
.PHONY: FORCE
FORCE:

## CMACS: Build emacsctl/cmacsctl (standalone kubectl-style control
## client; links NO Emacs objects --- pure GLib + json-glib +
## yaml-glib).  The inner Makefile does its own up-to-date check, so
## the FORCE hook is cheap on no-op runs.  Produces ./emacsctl and the
## ./cmacsctl symlink in the build's src/ directory.
CMACS_EMACSCTL_BIN = @CMACS_EMACSCTL_BIN@
ifneq ($(CMACS_EMACSCTL_BIN),)
all: emacsctl$(EXEEXT)
emacsctl$(EXEEXT): FORCE
	$(MAKE) -C $(srcdir)/../cmacs/emacsctl OUTDIR=$(abspath .) all
endif

## CMACS: Build the out-of-process screensaver renderer
## (cmacs-screensaver-render).  A standalone GLib/GObject binary that hosts the
## libregnum screensaver modules in its OWN GL context and streams frames to
## Emacs over shared memory; links the libregnum archive (+ CAD, like Emacs, so
## any loaded module resolves) but NO Emacs objects.  Mirrors the emacsctl
## nested-build pattern; built only when configured (gowl present).  Depends on
## the libregnum archive so its generated version headers exist.
CMACS_SCREENSAVER_RENDER_BIN = @CMACS_SCREENSAVER_RENDER_BIN@
ifneq ($(CMACS_SCREENSAVER_RENDER_BIN),)
all: cmacs-screensaver-render$(EXEEXT)
cmacs-screensaver-render$(EXEEXT): $(CMACS_LIBREGNUM_STATIC_LIB) FORCE
	$(MAKE) -C $(srcdir)/../cmacs/screensaver/render OUTDIR=$(abspath .) \
	    CMACS_LIBREGNUM_CFLAGS='$(CMACS_LIBREGNUM_CFLAGS)' \
	    CMACS_LIBREGNUM_LIBS='$(CMACS_LIBREGNUM_LIBS)' \
	    CMACS_CAD_LIBS='$(CMACS_CAD_LIBS)' all
endif

## Build liborm-glib-0.2.a (database access for the dbexplorer subsystem).
## FORCE because the sub-make decides incrementality, not this one.  The
## backend flags come from configure, which probed for libpq and the
## MariaDB connector -- so the archive contains exactly the drivers whose
## system libraries CMACS_DBEXPLORER_LIBS then links.
##
## orm-glib vendors no crispy or yaml-glib objects (verified with `ar t`),
## so unlike gowl and libreclaw it needs no duplicate-object strip rule.
ifneq ($(CMACS_DBEXPLORER_OBJ),)
CMACS_ORM_GLIB_STATIC_LIB = $(srcdir)/../deps/orm-glib/build/$(CMACS_DEP_BUILDTYPE)/liborm-glib-0.2.a
$(CMACS_ORM_GLIB_STATIC_LIB): FORCE
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) $(CMACS_DBEXPLORER_ORM_FLAGS) \
	    -C $(srcdir)/../deps/orm-glib lib

$(CMACS_DBEXPLORER_OBJ): $(CMACS_ORM_GLIB_STATIC_LIB)
endif

## Build libmcp-glib-1.0.a (MCP server library)
ifneq ($(CMACS_MCP_OBJ),)
ifeq ($(CMACS_MCP_BUNDLED),yes)
CMACS_MCP_STATIC_LIB = $(srcdir)/../deps/mcp-glib/build/libmcp-glib-1.0.a
$(CMACS_MCP_STATIC_LIB):
	$(MAKE) $(CMACS_DEP_MAKEFLAGS) -C $(srcdir)/../deps/mcp-glib

$(CMACS_MCP_OBJ): $(CMACS_MCP_STATIC_LIB)
endif
endif

## -------------------------------------------------------------------
## De-duplicate shared objects between bundled static libraries.
##
## crispy, bacon, and gowl each vendor copies of crispy and/or yaml-glib
## as git submodules at different commits, producing differently-compiled
## objects.  Linking all with --whole-archive and -Wl,-z,muldefs caused
## the linker to arbitrarily pick between incompatible implementations,
## leading to non-deterministic memory corruption and crashes.
##
## Fix: strip shared-dep objects from downstream archives before linking
## so each symbol has exactly one definition.
##   crispy objects -> canonical: libcrispy.a (standalone, most complete)
##   yaml-glib objects -> canonical: libbacon-1.0.a
## -------------------------------------------------------------------

_dup_crispy = crispy-cache-provider.o crispy-compiler.o \
  crispy-config-context.o crispy-config-loader.o crispy-file-cache.o \
  crispy-gcc-compiler.o crispy-plugin-engine.o crispy-script.o \
  crispy-source-utils-private.o
_dup_yaml = yaml-builder.o yaml-document.o yaml-generator.o \
  yaml-gobject.o yaml-mapping.o yaml-node.o yaml-parser.o yaml-schema.o \
  yaml-sequence.o yaml-serializable.o

## libreclaw vendors both yaml-glib AND podomation inside liblc-1.0.a.
## When cmacs is already pulling podomation as a bundled dep, those
## objects appear twice at link time.  Strip them from libreclaw's
## archive and rely on the canonical podomation (for pod_*) and
## bacon/gowl-provided (for yaml_*) copies.  libreclaw's own
## lc-podomation.o / lc-hatch.o / lc-app.o survive because they are
## prefixed with lc_ not pod_ / yaml_.
_dup_podomation_objs =

ifeq ($(CMACS_LIBRECLAW_BUNDLED),yes)
ifeq ($(CMACS_PODOMATION_BUNDLED),yes)
## Fetch the canonical podomation object list from its archive.  This
## runs at parse time, so libpodomation-1.0.a must already exist — it
## is built as a temacs dependency before this expansion is used
## thanks to the dedup-lib rule's prerequisite ordering below.
_dup_podomation_objs := $(shell ar t \
  $(srcdir)/../deps/podomation/build/$(CMACS_DEP_BUILDTYPE)/libpodomation-1.0.a 2>/dev/null)
endif
endif

_bacon_strip =
_gowl_strip =
_libreclaw_strip =

ifeq ($(CMACS_BACON_BUNDLED),yes)
ifeq ($(CMACS_CRISPY_BUNDLED),yes)
_bacon_strip += $(_dup_crispy)
endif
endif

ifeq ($(CMACS_GOWL_BUNDLED),yes)
ifneq ($(CMACS_CRISPY_BUNDLED)$(CMACS_BACON_BUNDLED),)
_gowl_strip += $(_dup_crispy)
endif
ifeq ($(CMACS_BACON_BUNDLED),yes)
_gowl_strip += $(_dup_yaml)
endif
endif

ifeq ($(CMACS_LIBRECLAW_BUNDLED),yes)
ifneq ($(CMACS_BACON_BUNDLED)$(CMACS_GOWL_BUNDLED),)
_libreclaw_strip += $(_dup_yaml)
endif
ifeq ($(CMACS_PODOMATION_BUNDLED),yes)
_libreclaw_strip += $(_dup_podomation_objs)
endif
endif

## gsurf's libgsurf.a merges crispy + yaml-glib objects (ar -M), which
## collide with cmacs's canonical copies.  Strip them so each symbol has
## exactly one definition (same policy as gowl/libreclaw).
_gsurf_strip =
ifeq ($(CMACS_GSURF_BUNDLED),yes)
ifneq ($(CMACS_CRISPY_BUNDLED)$(CMACS_BACON_BUNDLED),)
_gsurf_strip += $(_dup_crispy)
endif
ifeq ($(CMACS_BACON_BUNDLED),yes)
_gsurf_strip += $(_dup_yaml)
endif
endif

ifneq ($(_bacon_strip),)
CMACS_BACON_DEDUP_LIB = libbacon-dedup.a
$(CMACS_BACON_DEDUP_LIB): $(CMACS_BACON_STATIC_LIB)
	$(AM_V_GEN)cp $< $@ && ar d $@ $(_bacon_strip)
CMACS_BACON_LIBS := $(subst $(CMACS_BACON_STATIC_LIB),$(CMACS_BACON_DEDUP_LIB),$(CMACS_BACON_LIBS))
endif

comma := ,
ifneq ($(_gowl_strip),)
CMACS_GOWL_DEDUP_LIB = libgowl-dedup.a
$(CMACS_GOWL_DEDUP_LIB): $(CMACS_GOWL_STATIC_LIB)
	$(AM_V_GEN)cp $< $@ && ar d $@ $(_gowl_strip)
CMACS_GOWL_LIBS := $(subst $(CMACS_GOWL_STATIC_LIB),$(CMACS_GOWL_DEDUP_LIB),$(CMACS_GOWL_LIBS))
endif
CMACS_GOWL_LIBS := $(subst -Wl$(comma)-z$(comma)muldefs,,$(CMACS_GOWL_LIBS))

ifneq ($(_libreclaw_strip),)
CMACS_LIBRECLAW_DEDUP_LIB = liblibreclaw-dedup.a
$(CMACS_LIBRECLAW_DEDUP_LIB): $(CMACS_LIBRECLAW_STATIC_LIB) $(CMACS_PODOMATION_STATIC_LIB)
	$(AM_V_GEN)cp $< $@ && ar d $@ $(_libreclaw_strip) 2>/dev/null || true
CMACS_LIBRECLAW_LIBS := $(subst $(CMACS_LIBRECLAW_STATIC_LIB),$(CMACS_LIBRECLAW_DEDUP_LIB),$(CMACS_LIBRECLAW_LIBS))
endif

ifneq ($(_gsurf_strip),)
CMACS_GSURF_DEDUP_LIB = libgsurf-dedup.a
$(CMACS_GSURF_DEDUP_LIB): $(CMACS_GSURF_STATIC_LIB)
	$(AM_V_GEN)cp $< $@ && ar d $@ $(_gsurf_strip)
CMACS_GSURF_LIBS := $(subst $(CMACS_GSURF_STATIC_LIB),$(CMACS_GSURF_DEDUP_LIB),$(CMACS_GSURF_LIBS))
endif

## We have to create $(etc) here because init_cmdargs tests its
## existence when setting Vinstallation_directory (FIXME?).
## This goes on to affect various things, and the emacs binary fails
## to start if Vinstallation_directory has the wrong value.
temacs$(EXEEXT): $(LIBXMENU) $(ALLOBJS) $(LIBEGNU_ARCHIVE) $(EMACSRES) \
  $(charsets) $(charscript) ${emoji-zwj} $(MAKE_PDUMPER_FINGERPRINT) \
  $(CMACS_BACON_STATIC_LIB) $(CMACS_CRISPY_STATIC_LIB) $(CMACS_GOWL_STATIC_LIB) \
  $(CMACS_PODOMATION_STATIC_LIB) $(CMACS_LIBRECLAW_STATIC_LIB) \
  $(CMACS_AI_GLIB_STATIC_LIB) \
  $(if $(CMACS_CAD_OBJ),$(CMACS_CAD_GLIB_STATIC_LIB)) \
  $(if $(CMACS_DBEXPLORER_OBJ),$(CMACS_ORM_GLIB_STATIC_LIB)) \
  $(CMACS_LIBREGNUM_STATIC_LIB) \
  $(CMACS_GSURF_STATIC_LIB) \
  $(CMACS_BACON_DEDUP_LIB) $(CMACS_GOWL_DEDUP_LIB) $(CMACS_LIBRECLAW_DEDUP_LIB) \
  $(CMACS_GSURF_DEDUP_LIB)
ifeq ($(HAVE_BE_APP),yes)
	$(AM_V_CXXLD)$(CXX) -o $@.tmp \
	  $(ALL_CFLAGS) $(TEMACS_LDFLAGS) $(LDFLAGS) \
	  $(ALLOBJS) $(LIBEGNU_ARCHIVE) $(W32_RES_LINK) $(LIBES) -lstdc++
else
	$(AM_V_CCLD)$(CC) -o $@.tmp \
	  $(ALL_CFLAGS) $(CXXFLAGS) $(TEMACS_LDFLAGS) $(LDFLAGS) \
	  $(ALLOBJS) $(LIBEGNU_ARCHIVE) $(W32_RES_LINK) $(LIBES)
endif
ifeq ($(HAVE_PDUMPER),yes)
	$(AM_V_at)$(MAKE_PDUMPER_FINGERPRINT) $@.tmp
ifeq ($(DO_CODESIGN),yes)
	codesign -s - -f $@.tmp
endif
endif
	$(AM_V_at)mv $@.tmp $@
	$(MKDIR_P) $(etc)

ifeq ($(XCONFIGURE),android)
## The Android package internally links to a shared library named
## `libemacs.so' at startup.  It is built almost the same way temacs
## is.  But it is position independent, and is not dumped here.
## Instead, it dumps itself the first time it starts on the user's
## device.

# Include ndk-build.mk in order to build Emacs dependencies.
old_top_builddir := $(top_builddir)
top_builddir := $(old_top_builddir)/..
include $(old_top_builddir)/ndk-build/ndk-build.mk
top_builddir := $(old_top_builddir)

## Builds using libemacs.so (Android) don't dump Emacs within this
## Makefile, but on device.  Make sure the library hash changes for
## each change in shortlisp by linking an object that changes
## accordingly to it.
BUILD_COUNTER_OBJ = build-counter.o

# This file is then compiled into libemacs.so
build-counter.c: $(abs_top_builddir)/src/lisp.mk $(lisp)
	$(AM_V_GEN) $(top_srcdir)/build-aux/makecounter.sh $@

libemacs.so: $(ALLOBJS) $(BUILD_COUNTER_OBJ) $(LIBEGNU_ARCHIVE) \
	     $(EMACSRES) $(MAKE_PDUMPER_FINGERPRINT) \
	     $(NDK_BUILD_SHARED) $(NDK_BUILD_STATIC) $(etc)/DOC
	$(AM_V_CCLD)$(CC) -o $@ $(ALL_CFLAGS) $(TEMACS_LDFLAGS) \
	  $(ANDROID_LDFLAGS) $(LDFLAGS) -shared $(ALLOBJS) \
	  $(BUILD_COUNTER_OBJ) $(LIBEGNU_ARCHIVE) $(LIBES)
	$(AM_V_at)$(MAKE_PDUMPER_FINGERPRINT) $@

# There is also a binary named `android-emacs' which simply calls
# emacs.so.  It need not link against libemacs because app_process
# will do that instead.

android-emacs: android-emacs.c
	$(AM_V_CCLD)$(CC) $(lastword $^) -o $@ \
	  $(ALL_CFLAGS) $(LDFLAGS)	       \
	  $(LIBEGNU_ARCHIVE)
endif

## The following oldxmenu-related rules are only (possibly) used if
## HAVE_X11 && !USE_GTK, but there is no harm in always defining them.
$(lwlibdir)/liblw.a: $(config_h) globals.h lisp.h FORCE
	$(MAKE) -C $(dir $@) $(notdir $@)
$(oldXMenudir)/libXMenu11.a: FORCE
	$(MAKE) -C $(dir $@) $(notdir $@)
FORCE:
.PHONY: FORCE

.PRECIOUS: ../config.status Makefile
../config.status: $(top_srcdir)/configure.ac $(top_srcdir)/m4/*.m4
	$(MAKE) -C $(dir $@) $(notdir $@)
Makefile: ../config.status $(srcdir)/Makefile.in
	$(MAKE) -C .. src/$@

doc.o: buildobj.h

emacs.res: FORCE
	$(MAKE) -C ../nt ../src/emacs.res

.PHONY: ns-app
ns-app: emacs$(EXEEXT) $(pdmp)
	$(MAKE) -C ../nextstep all

.PHONY: mostlyclean clean bootstrap-clean distclean maintainer-clean
.PHONY: versionclean

mostlyclean:
	rm -f android-emacs libemacs.so
	rm -f temacs$(EXEEXT) core ./*.core \#* ./*.o build-counter.c
	rm -f dmpstruct.h
	rm -f emacs.pdmp
	rm -f ../etc/DOC
	rm -f bootstrap-emacs$(EXEEXT) $(bootstrap_pdmp)
	rm -f emacs-$(version)$(EXEEXT)
	rm -f buildobj.h
	rm -f globals.h gl-stamp
	rm -f ./*.res ./*.tmp
versionclean:
	rm -f emacs$(EXEEXT) emacs-*.*.*[0-9]$(EXEEXT) emacs-*.*.*[0-9].pdmp
	rm -f ../etc/DOC*
clean: mostlyclean versionclean
	rm -f $(DEPDIR)/*
	rm -f emacsctl$(EXEEXT) cmacsctl$(EXEEXT)
	rm -f cmacs-screensaver-render$(EXEEXT)
	-$(MAKE) -C $(srcdir)/../cmacs/screensaver/render clean OUTDIR=$(abspath .) 2>/dev/null

## bootstrap-clean is used to clean up just before a bootstrap.
## It should remove all files generated during a compilation/bootstrap,
## but not things like config.status or TAGS.
bootstrap-clean: clean
	rm -f emacs-module.h epaths.h config.h config.stamp
	if test -f ./.gdbinit; then \
	  mv ./.gdbinit ./.gdbinit.save; \
	  if test -f "$(srcdir)/.gdbinit"; then rm -f ./.gdbinit.save; \
	  else mv ./.gdbinit.save ./.gdbinit; fi; \
	fi

distclean: bootstrap-clean
	rm -f Makefile lisp.mk verbose.mk
	rm -fr $(DEPDIR)

maintainer-clean: distclean
	rm -f TAGS

ETAGS = $(libsrc)/etags${EXEEXT}

${ETAGS}: FORCE
	$(MAKE) -C $(dir $@) $(notdir $@)

# Remove macuvs.h since it'd cause `src/emacs`
# to be built before we can get TAGS.
ctagsfiles1 = $(filter-out ${srcdir}/macuvs.h, $(wildcard ${srcdir}/*.[hc]))
ctagsfiles2 = $(wildcard ${srcdir}/*.m)
ctagsfiles3 = $(wildcard ${srcdir}/*.cc)

## In out-of-tree builds, TAGS are generated in the build dir, like
## other non-bootstrap build products (see Bug#31744).

## This does not need to depend on ../lisp, ../lwlib and ../lib TAGS files,
## because etags "--include" only includes a pointer to the file,
## rather than the file contents.
TAGS: ${ETAGS} $(ctagsfiles1) $(ctagsfiles2)
	$(AM_V_GEN)${ETAGS} --include=../lisp/TAGS --include=$(lwlibdir)/TAGS \
	  --include=$(lib)/TAGS \
	  --regex='{c}/[ 	]*DEFVAR_[A-Z_ 	(]+"\([^"]+\)"/\1/' \
	  --regex='{c}/[ 	]*DEFVAR_[A-Z_ 	(]+"[^"]+",[ 	]\([A-Za-z0-9_]+\)/\1/' \
	  $(ctagsfiles1) \
	  --regex='{objc}/[ 	]*DEFVAR_[A-Z_ 	(]+"\([^"]+\)"/\1/' \
	  --regex='{objc}/[ 	]*DEFVAR_[A-Z_ 	(]+"[^"]+",[ 	]\([A-Za-z0-9_]+\)/\1/' \
	  $(ctagsfiles2) \
	  $(ctagsfiles3)

## Arrange to make tags tables for ../lisp, ../lwlib and ../lib,
## which the above TAGS file for the C files includes by reference.
../lisp/TAGS $(lwlibdir)/TAGS $(lib)/TAGS: FORCE
	$(MAKE) -C $(dir $@) $(notdir $@) ETAGS="$(ETAGS)"

tags: TAGS ../lisp/TAGS $(lwlibdir)/TAGS $(lib)/TAGS
.PHONY: tags


### Bootstrapping.

## Bootstrapping right is difficult because of the circular dependencies.
## Furthermore, we have to deal with the fact that many compilation targets
## such as loaddefs.el or *.elc can typically be produced by any old
## Emacs executable, so we would like to avoid rebuilding them whenever
## we build a new Emacs executable.
##
## (In other words, changing a single file src/foo.c would force
## dumping a new bootstrap-emacs, then re-byte-compiling all preloaded
## elisp files, and only then dump the actual src/emacs, which is not
## wrong, but is overkill in 99.99% of the cases.)
##
## To solve the circularity, we use 2 different Emacs executables,
## "emacs" is the main target and "bootstrap-emacs" is the one used
## to build the *.elc and loaddefs.el files.
## To solve the freshness issue, in the past we tried various clever tricks,
## but now that we require GNU make, we can simply specify
## bootstrap-emacs$(EXEEXT) as an order-only prerequisite.
##
## bootstrap-emacs doesn't have to be built when cross-compiling
## libemacs.so for Android, however, as the Lisp files have already
## been compiled by the top level `src' Makefile.

ifneq ($(XCONFIGURE),android)
%.elc: %.el | bootstrap-emacs$(EXEEXT) $(bootstrap_pdmp)
	@$(MAKE) $(AM_V_NO_PD) -C ../lisp EMACS="$(bootstrap_exe)"\
		THEFILE=$< $<c
endif

ifeq ($(HAVE_NATIVE_COMP):$(NATIVE_DISABLED),yes:)
## The following rules are used only when building a source tarball
## for the first time, when the native-lisp/ directory doesn't yet
## exist and needs to be created and populated with the preloaded
## *.eln files.

## List of *.eln files we need to produce in addition to the preloaded
## ones in $(lisp).
elnlisp := \
	emacs-lisp/byte-opt.eln \
	emacs-lisp/bytecomp.eln \
	emacs-lisp/cconv.eln \
	international/charscript.eln \
	emacs-lisp/comp.eln \
	emacs-lisp/comp-cstr.eln \
	emacs-lisp/comp-common.eln \
	emacs-lisp/comp-run.eln \
	international/emoji-zwj.eln
elnlisp := $(addprefix ${lispsource}/,${elnlisp}) $(lisp:.elc=.eln)

%.eln: %.el | emacs$(EXEEXT) $(pdmp)
	@$(MAKE) $(AM_V_NO_PD) -C ../lisp EMACS="../src/emacs$(EXEEXT)"\
		THEFILE=$< $<n

## FIXME: this is fragile!  We lie to Make about the files produced by
## this rule, and we rely on the absence of the native-lisp directory
## to trigger it.  This means that if anything goes wrong during
## native compilation, the only way to trigger it again is to remove
## the directory and re-native-compile everything.  The main
## underlying problem is that the name of the subdirectory of
## native-lisp where the *.eln files will be produced, and the exact
## names of those *.eln files, cannot be known in advance; we must ask
## Emacs to produce them.
## If AOT native compilation is requested, we additionally
## native-compile all the *.el files in ../lisp that need to be
## compiled and haven't yet been compiled.  ELDONE holds the list
## of *.el files that were already native-compiled.
NATIVE_COMPILATION_AOT = @NATIVE_COMPILATION_AOT@
../native-lisp: | $(pdmp)
	@if test ! -d $@; then \
	  mkdir $@ && $(MAKE) $(AM_V_NO_PD) $(elnlisp); \
	  if test $(SYSTEM_TYPE) = cygwin; then \
	    find $@ -name '*.eln' | rebase -v -O -T -; \
	  fi; \
	  LC_ALL=C $(RUN_TEMACS) -batch $(BUILD_DETAILS) -l loadup --temacs=pdump \
		--bin-dest '$(BIN_DESTDIR)' --eln-dest '$(ELN_DESTDIR)' \
	  && cp -f emacs$(EXEEXT) bootstrap-emacs$(EXEEXT) \
	  && cp -f $(pdmp) $(bootstrap_pdmp); \
	  if test $(NATIVE_COMPILATION_AOT) = yes; then \
	    $(MAKE) $(AM_V_NO_PD) -C ../lisp compile-eln-aot EMACS="../src/emacs$(EXEEXT)" ELNDONE="$(addprefix %,$(notdir $(elnlisp))))"; \
	  fi; \
	fi
endif

ifneq ($(XCONFIGURE),android)
$(lispsource)/loaddefs.el: |  		       \
    bootstrap-emacs$(EXEEXT) $(bootstrap_pdmp) \
    $(lispsource)/international/charprop.el
	$(MAKE) -C ../lisp autoloads EMACS="$(bootstrap_exe)"
endif

## Dump an Emacs executable named bootstrap-emacs containing the
## files from loadup.el in source form.

bootstrap-emacs$(EXEEXT): temacs$(EXEEXT)
	$(MAKE) -C ../lisp update-subdirs
	@: In the pdumper case, make compile-first after the dump
	cp -f temacs$(EXEEXT) bootstrap-emacs$(EXEEXT)
ifeq ($(DO_CODESIGN),yes)
	codesign -s - -f bootstrap-emacs$(EXEEXT)
endif

ifeq ($(DUMPING),pdumper)
$(bootstrap_pdmp): bootstrap-emacs$(EXEEXT)
	rm -f $@
	$(RUN_TEMACS) --batch $(BUILD_DETAILS) -l loadup --temacs=pbootstrap \
		--bin-dest '$(BIN_DESTDIR)' --eln-dest '$(ELN_DESTDIR)'
	@: Compile some files earlier to speed up further compilation.
	@: First, byte compile these files, ....
	ANCIENT=yes $(MAKE) -C ../lisp compile-first EMACS="$(bootstrap_exe)"
	@: .... then use their .elcs in native compiling these and other files.
	$(MAKE) -C ../lisp compile-first EMACS="$(bootstrap_exe)"
endif

### Flymake support (for C only)
check-syntax:
	$(AM_V_CC)$(CC) -c $(CPPFLAGS) $(ALL_CFLAGS) ${CHK_SOURCES} || true
.PHONY: check-syntax
